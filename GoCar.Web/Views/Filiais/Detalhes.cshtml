@model GoCar.Web.Models.FilialViewModel

@{
    ViewData["Title"] = "Detalhes da Filial";
}

<style>
    .branch-page {
        max-width: 1500px;
        margin: auto;
        padding: 32px;
        color: #fff;
    }

    .branch-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .branch-eyebrow {
        margin-bottom: 4px;
        color: #a99fb4;
        font-size: .90rem;
        text-transform: uppercase;
        letter-spacing: .6px;
        font-weight: 700;
    }

    .branch-title {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .branch-description {
        margin: 6px 0 0;
        color: #aaa0b5;
        font-size: .96rem;
    }

    .branch-actions {
        display: flex;
        gap: 8px;
    }

    .branch-btn,
    .branch-btn-primary {
        min-height: 40px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        text-decoration: none;
        font-size: .90rem;
        font-weight: 700;
        transition: .18s ease;
    }

    .branch-btn {
        border: 1px solid rgba(151,71,255,.24);
        background: rgba(126,44,255,.06);
        color: #fff;
    }

        .branch-btn:hover {
            color: #fff;
            background: rgba(126,44,255,.12);
            border-color: rgba(151,71,255,.45);
        }

    .branch-btn-primary {
        border: 1px solid #8b3dff;
        background: linear-gradient( 135deg, #7c2cff, #9b4dff );
        color: #fff;
        box-shadow: 0 8px 25px rgba(126,44,255,.18);
    }

        .branch-btn-primary:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .branch-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 16px;
        padding: 24px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: radial-gradient( circle at 90% 20%, rgba(126,44,255,.13), transparent 32% ), linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
    }

    .branch-hero-main {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .branch-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(151,71,255,.22);
        border-radius: 12px;
        background: rgba(126,44,255,.09);
        color: #bd91ff;
        font-size: 1.35rem;
    }

    .branch-hero small {
        color: #aaa0b5;
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .branch-hero h2 {
        margin: 3px 0 5px;
        color: #fff;
        font-size: 1.25rem;
        font-weight: 800;
    }

    .branch-location {
        color: #b7adbf;
        font-size: .90rem;
    }

    .branch-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .84rem;
        font-weight: 700;
    }

        .branch-status::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: currentColor;
        }

    .branch-active {
        color: #3ce78c;
        background: rgba(26,192,103,.12);
    }

    .branch-inactive {
        color: #b4aabd;
        background: rgba(148,163,184,.10);
    }

    .branch-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 16px;
    }

    .branch-card {
        overflow: hidden;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
        transition: .18s ease;
    }

        .branch-card:hover {
            border-color: rgba(151,71,255,.27);
            transform: translateY(-1px);
        }

    .branch-card-header {
        padding: 17px 19px;
        border-bottom: 1px solid rgba(255,255,255,.045);
    }

        .branch-card-header small {
            display: block;
            margin-bottom: 3px;
            color: #aaa0b5;
            font-size: .82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .55px;
        }

        .branch-card-header h3 {
            margin: 0;
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
        }

    .branch-card-body {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
    }

    .branch-data {
        min-height: 88px;
        padding: 15px 19px;
        border-right: 1px solid rgba(255,255,255,.035);
        border-bottom: 1px solid rgba(255,255,255,.035);
    }

        .branch-data:nth-child(even) {
            border-right: 0;
        }

    .branch-data-label {
        margin-bottom: 6px;
        color: #aaa0b5;
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .branch-data-value {
        color: #ded8e5;
        font-size: .92rem;
        line-height: 1.5;
        word-break: break-word;
    }

    .branch-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid rgba(255,255,255,.04);
    }

    @@media (max-width: 800px) {
        .branch-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .branch-page {
            padding: 20px 15px;
        }

        .branch-header,
        .branch-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .branch-actions {
            width: 100%;
        }

            .branch-actions a {
                flex: 1;
            }

        .branch-card-body {
            grid-template-columns: 1fr;
        }

        .branch-data {
            border-right: 0;
        }

        .branch-footer {
            flex-direction: column-reverse;
        }

            .branch-footer a {
                width: 100%;
            }
    }
</style>

<div class="branch-page">

    <div class="branch-header">

        <div>

            <div class="branch-eyebrow">
                Gestão de unidades
            </div>

            <h1 class="branch-title">
                Detalhes da Filial
            </h1>

            <p class="branch-description">
                Informações completas da unidade GoCar.
            </p>

        </div>

        <div class="branch-actions">

            <a asp-controller="Filiais"
               asp-action="Index"
               class="branch-btn">
                ← Voltar
            </a>

            <a asp-controller="Filiais"
               asp-action="Editar"
               asp-route-id="@Model.Id"
               class="branch-btn-primary">
                Editar Filial
            </a>

        </div>

    </div>


    <div class="branch-hero">

        <div class="branch-hero-main">

            <div class="branch-icon">
                ◆
            </div>

            <div>

                <small>
                    Filial #@Model.Id
                </small>

                <h2>
                    @Model.Nome
                </h2>

                <div class="branch-location">
                    @Model.Cidade / @Model.Estado
                </div>

            </div>

        </div>

        @if (Model.IsAtivo)
        {
            <span class="branch-status branch-active">
                Ativa
            </span>
        }
        else
        {
            <span class="branch-status branch-inactive">
                Inativa
            </span>
        }

    </div>


    <div class="branch-grid">

        <div class="branch-card">

            <div class="branch-card-header">

                <small>
                    Cadastro
                </small>

                <h3>
                    Dados da filial
                </h3>

            </div>

            <div class="branch-card-body">

                <div class="branch-data">

                    <div class="branch-data-label">
                        ID
                    </div>

                    <div class="branch-data-value">
                        @Model.Id
                    </div>

                </div>

                <div class="branch-data">

                    <div class="branch-data-label">
                        Status
                    </div>

                    <div class="branch-data-value">
                        @(Model.IsAtivo ? "Ativa" : "Inativa")
                    </div>

                </div>

                <div class="branch-data">

                    <div class="branch-data-label">
                        Nome
                    </div>

                    <div class="branch-data-value">
                        @Model.Nome
                    </div>

                </div>

                <div class="branch-data">

                    <div class="branch-data-label">
                        CNPJ
                    </div>

                    <div class="branch-data-value">
                        @Model.CNPJ
                    </div>

                </div>

            </div>

        </div>


        <div class="branch-card">

            <div class="branch-card-header">

                <small>
                    Contato
                </small>

                <h3>
                    Canais da unidade
                </h3>

            </div>

            <div class="branch-card-body">

                <div class="branch-data">

                    <div class="branch-data-label">
                        Telefone
                    </div>

                    <div class="branch-data-value">
                        @Model.Telefone
                    </div>

                </div>

                <div class="branch-data">

                    <div class="branch-data-label">
                        E-mail
                    </div>

                    <div class="branch-data-value">
                        @Model.Email
                    </div>

                </div>

            </div>

        </div>


        <div class="branch-card">

            <div class="branch-card-header">

                <small>
                    Localização
                </small>

                <h3>
                    Endereço da filial
                </h3>

            </div>

            <div class="branch-card-body">

                <div class="branch-data">

                    <div class="branch-data-label">
                        Endereço
                    </div>

                    <div class="branch-data-value">
                        @Model.Endereco
                    </div>

                </div>

                <div class="branch-data">

                    <div class="branch-data-label">
                        Número
                    </div>

                    <div class="branch-data-value">
                        @Model.Numero
                    </div>

                </div>

                <div class="branch-data">

                    <div class="branch-data-label">
                        Bairro
                    </div>

                    <div class="branch-data-value">
                        @Model.Bairro
                    </div>

                </div>

                <div class="branch-data">

                    <div class="branch-data-label">
                        CEP
                    </div>

                    <div class="branch-data-value">
                        @Model.CEP
                    </div>

                </div>

            </div>

        </div>


        <div class="branch-card">

            <div class="branch-card-header">

                <small>
                    Região
                </small>

                <h3>
                    Cidade e estado
                </h3>

            </div>

            <div class="branch-card-body">

                <div class="branch-data">

                    <div class="branch-data-label">
                        Cidade
                    </div>

                    <div class="branch-data-value">
                        @Model.Cidade
                    </div>

                </div>

                <div class="branch-data">

                    <div class="branch-data-label">
                        Estado
                    </div>

                    <div class="branch-data-value">
                        @Model.Estado
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="branch-footer">

        <a asp-controller="Filiais"
           asp-action="Index"
           class="branch-btn">
            Voltar
        </a>

        <a asp-controller="Filiais"
           asp-action="Editar"
           asp-route-id="@Model.Id"
           class="branch-btn-primary">
            Editar Filial
        </a>

    </div>

</div>