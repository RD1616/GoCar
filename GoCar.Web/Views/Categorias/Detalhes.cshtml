@model GoCar.Web.Models.CategoriaViewModel

@{
    ViewData["Title"] = "Detalhes da Categoria";
}

<style>
    .category-page {
        max-width: 1500px;
        margin: auto;
        padding: 32px;
        color: #fff;
    }

    .category-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .category-eyebrow {
        color: #a99fb4;
        font-size: .90rem;
        text-transform: uppercase;
        letter-spacing: .6px;
        margin-bottom: 4px;
        font-weight: 700;
    }

    .category-title {
        margin: 0;
        color: #fff;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .category-description {
        margin: 6px 0 0;
        color: #aaa0b5;
        font-size: .96rem;
    }

    .category-actions {
        display: flex;
        gap: 8px;
    }

    .category-btn,
    .category-btn-primary {
        min-height: 40px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        text-decoration: none;
        font-size: .90rem;
        font-weight: 700;
        transition: .18s ease;
    }

    .category-btn {
        border: 1px solid rgba(151,71,255,.24);
        background: rgba(126,44,255,.06);
        color: #fff;
    }

        .category-btn:hover {
            color: #fff;
            background: rgba(126,44,255,.12);
            border-color: rgba(151,71,255,.45);
        }

    .category-btn-primary {
        border: 1px solid #8b3dff;
        background: linear-gradient( 135deg, #7c2cff, #9b4dff );
        color: #fff;
        box-shadow: 0 8px 25px rgba(126,44,255,.18);
    }

        .category-btn-primary:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .category-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 24px;
        margin-bottom: 16px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: radial-gradient( circle at 90% 20%, rgba(126,44,255,.13), transparent 32% ), linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
    }

    .category-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 55px;
        border-radius: 12px;
        background: rgba(126,44,255,.10);
        border: 1px solid rgba(151,71,255,.22);
        color: #bd91ff;
        font-size: 1.3rem;
        font-weight: 800;
    }

    .category-hero-main {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .category-hero small {
        color: #aaa0b5;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        font-weight: 700;
    }

    .category-hero h2 {
        margin: 3px 0 0;
        color: #fff;
        font-size: 1.25rem;
        font-weight: 800;
    }

    .category-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .84rem;
        font-weight: 700;
    }

        .category-status::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: currentColor;
        }

    .category-active {
        color: #3ce78c;
        background: rgba(26,192,103,.12);
    }

    .category-inactive {
        color: #b4aabd;
        background: rgba(148,163,184,.10);
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 16px;
    }

    .category-card {
        padding: 20px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
        transition: .18s ease;
    }

        .category-card:hover {
            border-color: rgba(151,71,255,.27);
            transform: translateY(-1px);
        }

    .category-card-label {
        margin-bottom: 7px;
        color: #aaa0b5;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        font-weight: 700;
    }

    .category-card-value {
        color: #fff;
        font-size: 1.15rem;
        font-weight: 800;
    }

    .category-card-sub {
        margin-top: 5px;
        color: #9e94a8;
        font-size: .84rem;
        line-height: 1.5;
    }

    .category-description-card {
        grid-column: 1 / -1;
        padding: 20px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
    }

        .category-description-card h3 {
            margin: 0 0 9px;
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
        }

        .category-description-card p {
            margin: 0;
            color: #bcb2c4;
            font-size: .92rem;
            line-height: 1.7;
        }

    .category-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid rgba(255,255,255,.04);
    }

    @@media (max-width: 700px) {

        .category-page {
            padding: 20px 15px;
        }

        .category-header,
        .category-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .category-actions {
            width: 100%;
        }

            .category-actions a {
                flex: 1;
            }

        .category-grid {
            grid-template-columns: 1fr;
        }

        .category-description-card {
            grid-column: auto;
        }

        .category-footer {
            flex-direction: column-reverse;
        }

            .category-footer a {
                width: 100%;
            }
    }
</style>

<div class="category-page">

    <div class="category-header">

        <div>

            <div class="category-eyebrow">
                Gestão da frota
            </div>

            <h1 class="category-title">
                Detalhes da Categoria
            </h1>

            <p class="category-description">
                Informações e valores da categoria selecionada.
            </p>

        </div>

        <div class="category-actions">

            <a asp-controller="Categorias"
               asp-action="Index"
               class="category-btn">
                ← Voltar
            </a>

            <a asp-controller="Categorias"
               asp-action="Editar"
               asp-route-id="@Model.Id"
               class="category-btn-primary">
                Editar Categoria
            </a>

        </div>

    </div>


    <div class="category-hero">

        <div class="category-hero-main">

            <div class="category-icon">
                @(string.IsNullOrWhiteSpace(Model.Nome)
                    ? "?"
                    : Model.Nome.Substring(0, 1).ToUpper())
            </div>

            <div>

                <small>
                    Categoria #@Model.Id
                </small>

                <h2>
                    @Model.Nome
                </h2>

            </div>

        </div>

        @if (Model.IsAtivo)
        {
            <span class="category-status category-active">
                Ativa
            </span>
        }
        else
        {
            <span class="category-status category-inactive">
                Inativa
            </span>
        }

    </div>


    <div class="category-grid">

        <div class="category-card">

            <div class="category-card-label">
                Diária Base
            </div>

            <div class="category-card-value">
                @(Model.DiariaBase.ToString("C"))
            </div>

            <div class="category-card-sub">
                Valor base por diária
            </div>

        </div>


        <div class="category-card">

            <div class="category-card-label">
                KM Livre
            </div>

            <div class="category-card-value">
                @Model.KmLivre km
            </div>

            <div class="category-card-sub">
                Franquia de quilometragem
            </div>

        </div>


        <div class="category-card">

            <div class="category-card-label">
                Situação
            </div>

            <div class="category-card-value">
                @(Model.IsAtivo ? "Ativa" : "Inativa")
            </div>

            <div class="category-card-sub">
                Status atual do cadastro
            </div>

        </div>


        <div class="category-description-card">

            <h3>
                Descrição
            </h3>

            <p>
                @(string.IsNullOrWhiteSpace(Model.Descricao)
                    ? "Nenhuma descrição cadastrada."
                    : Model.Descricao)
            </p>

        </div>

    </div>


    <div class="category-footer">

        <a asp-controller="Categorias"
           asp-action="Index"
           class="category-btn">
            Voltar
        </a>

        <a asp-controller="Categorias"
           asp-action="Editar"
           asp-route-id="@Model.Id"
           class="category-btn-primary">
            Editar Categoria
        </a>

    </div>

</div>