@model GoCar.Web.Models.FilialViewModel

@{
    ViewData["Title"] = "Editar Filial";
}

<style>
    .branch-form-page {
        max-width: 1500px;
        margin: auto;
        padding: 32px;
        color: #fff;
    }

    .branch-form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .branch-eyebrow {
        margin-bottom: 4px;
        color: #a99fb4;
        font-size: .90rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .branch-title {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .branch-description {
        margin: 6px 0 0;
        color: #aaa0b5;
        font-size: .96rem;
    }

    .form-btn,
    .form-btn-primary {
        min-height: 40px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        text-decoration: none;
        font-size: .90rem;
        font-weight: 700;
        transition: .18s ease;
    }

    .form-btn {
        border: 1px solid rgba(151,71,255,.24);
        background: rgba(126,44,255,.06);
        color: #fff;
    }

        .form-btn:hover {
            color: #fff;
            background: rgba(126,44,255,.12);
            border-color: rgba(151,71,255,.45);
        }

    .form-btn-primary {
        border: 1px solid #8b3dff;
        background: linear-gradient( 135deg, #7c2cff, #9b4dff );
        color: #fff;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(126,44,255,.18);
    }

        .form-btn-primary:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .branch-summary {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 16px;
        padding: 20px 22px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: radial-gradient( circle at 90% 20%, rgba(126,44,255,.12), transparent 30% ), linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
    }

    .branch-summary-icon {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(151,71,255,.2);
        border-radius: 11px;
        background: rgba(126,44,255,.08);
        color: #bd91ff;
        font-size: 1.25rem;
    }

    .branch-summary small {
        color: #aaa0b5;
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .branch-summary h2 {
        margin: 3px 0 0;
        color: #fff;
        font-size: 1.05rem;
        font-weight: 750;
    }

    .branch-form-card {
        overflow: hidden;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
    }

    .branch-form-section {
        padding: 22px;
        border-bottom: 1px solid rgba(255,255,255,.045);
    }

    .section-heading {
        margin-bottom: 18px;
    }

        .section-heading small {
            display: block;
            margin-bottom: 3px;
            color: #aaa0b5;
            font-size: .82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .55px;
        }

        .section-heading h3 {
            margin: 0;
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
        }

    .branch-form-grid {
        display: grid;
        grid-template-columns: repeat(12,minmax(0,1fr));
        gap: 15px;
    }

    .col-4x {
        grid-column: span 4;
    }

    .col-6x {
        grid-column: span 6;
    }

    .col-8x {
        grid-column: span 8;
    }

    .field label {
        display: block;
        margin-bottom: 6px;
        color: #c3bacb;
        font-size: .88rem;
        font-weight: 700;
    }

    .branch-input {
        width: 100%;
        min-height: 41px;
        padding: 9px 11px;
        border: 1px solid rgba(151,71,255,.17);
        border-radius: 7px;
        outline: none;
        background: rgba(255,255,255,.025);
        color: #ded8e5;
        font-size: .90rem;
        transition: .15s ease;
    }

        .branch-input:focus {
            border-color: rgba(151,71,255,.65);
            background: rgba(126,44,255,.045);
            box-shadow: 0 0 0 3px rgba(126,44,255,.07);
        }

    .validation-text {
        display: block;
        margin-top: 5px;
        color: #ff718d;
        font-size: .82rem;
    }

    .validation-summary-errors {
        margin-bottom: 18px;
        padding: 12px 14px;
        border: 1px solid rgba(244,63,94,.22);
        border-radius: 8px;
        background: rgba(244,63,94,.07);
        color: #ff91a7;
        font-size: .86rem;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

    .active-box {
        min-height: 41px;
        display: flex;
        align-items: center;
        padding: 10px 13px;
        border: 1px solid rgba(151,71,255,.13);
        border-radius: 7px;
        background: rgba(126,44,255,.025);
    }

    .active-check {
        display: flex;
        align-items: center;
        gap: 9px;
    }

        .active-check input {
            width: 17px;
            height: 17px;
            margin: 0;
            accent-color: #8b3dff;
            cursor: pointer;
        }

        .active-check label {
            margin: 0;
            color: #c6bdcf;
            font-size: .88rem;
            font-weight: 700;
            cursor: pointer;
        }

    .branch-form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 18px 22px;
        background: rgba(6,3,11,.22);
    }

        .branch-form-footer button {
            font-family: inherit;
        }

    @@media (max-width: 750px) {
        .branch-form-page {
            padding: 20px 15px;
        }

        .branch-form-header {
            align-items: flex-start;
            flex-direction: column;
        }

            .branch-form-header .form-btn {
                width: 100%;
            }

        .col-4x,
        .col-6x,
        .col-8x {
            grid-column: span 12;
        }

        .branch-form-footer {
            flex-direction: column-reverse;
        }

            .branch-form-footer a,
            .branch-form-footer button {
                width: 100%;
            }
    }
</style>

<div class="branch-form-page">

    <div class="branch-form-header">

        <div>

            <div class="branch-eyebrow">
                Gestão de unidades
            </div>

            <h1 class="branch-title">
                Editar Filial
            </h1>

            <p class="branch-description">
                Atualize as informações da unidade.
            </p>

        </div>

        <a asp-controller="Filiais"
           asp-action="Detalhes"
           asp-route-id="@Model.Id"
           class="form-btn">

            ← Detalhes

        </a>

    </div>


    <div class="branch-summary">

        <div class="branch-summary-icon">
            ◆
        </div>

        <div>

            <small>
                Filial #@Model.Id
            </small>

            <h2>
                @Model.Nome
            </h2>

        </div>

    </div>


    <div class="branch-form-card">

        <form asp-controller="Filiais"
              asp-action="Editar"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />


            <div class="branch-form-section">

                <div asp-validation-summary="ModelOnly">
                </div>

                <div class="section-heading">

                    <small>
                        Cadastro
                    </small>

                    <h3>
                        Dados da filial
                    </h3>

                </div>


                <div class="branch-form-grid">

                    <div class="field col-8x">

                        <label asp-for="Nome">
                            Nome da Filial
                        </label>

                        <input asp-for="Nome"
                               class="branch-input" />

                        <span asp-validation-for="Nome"
                              class="validation-text">
                        </span>

                    </div>


                    <div class="field col-4x">

                        <label asp-for="CNPJ">
                            CNPJ
                        </label>

                        <input asp-for="CNPJ"
                               class="branch-input" />

                        <span asp-validation-for="CNPJ"
                              class="validation-text">
                        </span>

                    </div>


                    <div class="field col-6x">

                        <label asp-for="Telefone">
                            Telefone
                        </label>

                        <input asp-for="Telefone"
                               class="branch-input" />

                        <span asp-validation-for="Telefone"
                              class="validation-text">
                        </span>

                    </div>


                    <div class="field col-6x">

                        <label asp-for="Email">
                            E-mail
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="branch-input" />

                        <span asp-validation-for="Email"
                              class="validation-text">
                        </span>

                    </div>

                </div>

            </div>


            <div class="branch-form-section">

                <div class="section-heading">

                    <small>
                        Localização
                    </small>

                    <h3>
                        Endereço da unidade
                    </h3>

                </div>


                <div class="branch-form-grid">

                    <div class="field col-8x">

                        <label asp-for="Endereco">
                            Endereço
                        </label>

                        <input asp-for="Endereco"
                               class="branch-input" />

                        <span asp-validation-for="Endereco"
                              class="validation-text">
                        </span>

                    </div>


                    <div class="field col-4x">

                        <label asp-for="Numero">
                            Número
                        </label>

                        <input asp-for="Numero"
                               class="branch-input" />

                        <span asp-validation-for="Numero"
                              class="validation-text">
                        </span>

                    </div>


                    <div class="field col-6x">

                        <label asp-for="Bairro">
                            Bairro
                        </label>

                        <input asp-for="Bairro"
                               class="branch-input" />

                        <span asp-validation-for="Bairro"
                              class="validation-text">
                        </span>

                    </div>


                    <div class="field col-6x">

                        <label asp-for="Cidade">
                            Cidade
                        </label>

                        <input asp-for="Cidade"
                               class="branch-input" />

                        <span asp-validation-for="Cidade"
                              class="validation-text">
                        </span>

                    </div>


                    <div class="field col-4x">

                        <label asp-for="Estado">
                            Estado
                        </label>

                        <input asp-for="Estado"
                               class="branch-input"
                               maxlength="2" />

                        <span asp-validation-for="Estado"
                              class="validation-text">
                        </span>

                    </div>


                    <div class="field col-4x">

                        <label asp-for="CEP">
                            CEP
                        </label>

                        <input asp-for="CEP"
                               class="branch-input" />

                        <span asp-validation-for="CEP"
                              class="validation-text">
                        </span>

                    </div>


                    <div class="field col-4x">

                        <label>
                            Status
                        </label>

                        <div class="active-box">

                            <div class="active-check">

                                <input asp-for="IsAtivo" />

                                <label asp-for="IsAtivo">
                                    Filial ativa
                                </label>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="branch-form-footer">

                <a asp-controller="Filiais"
                   asp-action="Index"
                   class="form-btn">

                    Cancelar

                </a>

                <button type="submit"
                        class="form-btn-primary">

                    Salvar Alterações

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}