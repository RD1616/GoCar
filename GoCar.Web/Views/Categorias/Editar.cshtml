@model GoCar.Web.Models.CategoriaViewModel

@{
    ViewData["Title"] = "Editar Categoria";
}

<style>
    .category-form-page {
        max-width: 1500px;
        margin: auto;
        padding: 32px;
        color: #fff;
    }

    .category-form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .category-form-eyebrow {
        color: #a99fb4;
        font-size: .90rem;
        text-transform: uppercase;
        letter-spacing: .6px;
        margin-bottom: 4px;
        font-weight: 700;
    }

    .category-form-title {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .category-form-description {
        margin: 6px 0 0;
        color: #aaa0b5;
        font-size: .96rem;
    }

    .form-btn,
    .form-btn-primary {
        min-height: 40px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        text-decoration: none;
        font-size: .90rem;
        font-weight: 700;
        transition: .18s ease;
    }

    .form-btn {
        border: 1px solid rgba(151,71,255,.24);
        background: rgba(126,44,255,.06);
        color: #fff;
    }

        .form-btn:hover {
            color: #fff;
            background: rgba(126,44,255,.12);
            border-color: rgba(151,71,255,.45);
        }

    .form-btn-primary {
        border: 1px solid #8b3dff;
        background: linear-gradient( 135deg, #7c2cff, #9b4dff );
        color: #fff;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(126,44,255,.18);
    }

        .form-btn-primary:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .category-form-card {
        overflow: hidden;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
    }

    .category-form-section {
        padding: 22px;
        border-bottom: 1px solid rgba(255,255,255,.045);
    }

    .form-section-title {
        margin-bottom: 18px;
    }

        .form-section-title small {
            display: block;
            margin-bottom: 3px;
            color: #a99fb4;
            font-size: .82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .55px;
        }

        .form-section-title h3 {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
        }

    .category-form-grid {
        display: grid;
        grid-template-columns: repeat(12,minmax(0,1fr));
        gap: 15px;
    }

    .category-col-3 {
        grid-column: span 3;
    }

    .category-col-6 {
        grid-column: span 6;
    }

    .category-col-12 {
        grid-column: span 12;
    }

    .category-field label {
        display: block;
        margin-bottom: 6px;
        color: #c3bacb;
        font-size: .88rem;
        font-weight: 700;
    }

    .category-input {
        width: 100%;
        min-height: 41px;
        padding: 9px 11px;
        border: 1px solid rgba(151,71,255,.17);
        border-radius: 7px;
        outline: none;
        background: rgba(255,255,255,.025);
        color: #ded8e5;
        font-size: .90rem;
        transition: .15s ease;
    }

    textarea.category-input {
        min-height: 115px;
        resize: vertical;
        line-height: 1.5;
    }

    .category-input:focus {
        border-color: rgba(151,71,255,.65);
        background: rgba(126,44,255,.045);
        box-shadow: 0 0 0 3px rgba(126,44,255,.07);
    }

    .category-validation {
        display: block;
        margin-top: 5px;
        color: #ff718d;
        font-size: .82rem;
    }

    .validation-summary-errors {
        margin-bottom: 18px;
        padding: 12px 14px;
        border: 1px solid rgba(244,63,94,.22);
        border-radius: 8px;
        background: rgba(244,63,94,.07);
        color: #ff91a7;
        font-size: .86rem;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

    .category-active-box {
        display: flex;
        align-items: center;
        padding: 13px 14px;
        border: 1px solid rgba(151,71,255,.13);
        border-radius: 8px;
        background: rgba(126,44,255,.025);
    }

    .category-active-check {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .category-active-check input {
            width: 17px;
            height: 17px;
            margin: 0;
            accent-color: #8b3dff;
            cursor: pointer;
        }

        .category-active-check label {
            margin: 0;
            color: #c6bdcf;
            font-size: .88rem;
            font-weight: 700;
            cursor: pointer;
        }

    .category-form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 18px 22px;
        background: rgba(6,3,11,.22);
    }

        .category-form-footer button {
            font-family: inherit;
        }

    @@media (max-width: 700px) {
        .category-form-page {
            padding: 20px 15px;
        }

        .category-form-header {
            align-items: flex-start;
            flex-direction: column;
        }

            .category-form-header .form-btn {
                width: 100%;
            }

        .category-col-3,
        .category-col-6 {
            grid-column: span 12;
        }

        .category-form-footer {
            flex-direction: column-reverse;
        }

            .category-form-footer a,
            .category-form-footer button {
                width: 100%;
            }
    }
</style>

<div class="category-form-page">

    <div class="category-form-header">

        <div>

            <div class="category-form-eyebrow">
                Gestão da frota
            </div>

            <h1 class="category-form-title">
                Editar Categoria
            </h1>

            <p class="category-form-description">
                Atualize os valores e informações da categoria.
            </p>

        </div>

        <a asp-controller="Categorias"
           asp-action="Detalhes"
           asp-route-id="@Model.Id"
           class="form-btn">

            ← Detalhes

        </a>

    </div>


    <div class="category-form-card">

        <form asp-controller="Categorias"
              asp-action="Editar"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />


            <div class="category-form-section">

                <div asp-validation-summary="ModelOnly">
                </div>


                <div class="form-section-title">

                    <small>
                        Categoria #@Model.Id
                    </small>

                    <h3>
                        Informações principais
                    </h3>

                </div>


                <div class="category-form-grid">

                    <div class="category-field category-col-6">

                        <label asp-for="Nome">
                            Nome
                        </label>

                        <input asp-for="Nome"
                               class="category-input" />

                        <span asp-validation-for="Nome"
                              class="category-validation">
                        </span>

                    </div>


                    <div class="category-field category-col-3">

                        <label asp-for="DiariaBase">
                            Diária Base
                        </label>

                        <input asp-for="DiariaBase"
                               type="number"
                               step="0.01"
                               min="0"
                               class="category-input" />

                        <span asp-validation-for="DiariaBase"
                              class="category-validation">
                        </span>

                    </div>


                    <div class="category-field category-col-3">

                        <label asp-for="KmLivre">
                            KM Livre
                        </label>

                        <input asp-for="KmLivre"
                               type="number"
                               min="0"
                               class="category-input" />

                        <span asp-validation-for="KmLivre"
                              class="category-validation">
                        </span>

                    </div>


                    <div class="category-field category-col-12">

                        <label asp-for="Descricao">
                            Descrição
                        </label>

                        <textarea asp-for="Descricao"
                                  class="category-input"
                                  rows="4"></textarea>

                        <span asp-validation-for="Descricao"
                              class="category-validation">
                        </span>

                    </div>


                    <div class="category-field category-col-12">

                        <label>
                            Situação
                        </label>

                        <div class="category-active-box">

                            <div class="category-active-check">

                                <input asp-for="IsAtivo" />

                                <label asp-for="IsAtivo">
                                    Categoria ativa
                                </label>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="category-form-footer">

                <a asp-controller="Categorias"
                   asp-action="Index"
                   class="form-btn">

                    Cancelar

                </a>


                <button type="submit"
                        class="form-btn-primary">

                    Salvar Alterações

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}