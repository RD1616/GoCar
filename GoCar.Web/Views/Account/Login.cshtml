@model GoCar.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Entrar";
}

<section class="login-section">

    <div class="container">

        <div class="login-wrapper">

            <div class="login-card">

                <!-- CABEÇALHO -->

                <div class="login-header">

                    <div class="login-brand">
                        Go<span>Car</span>
                    </div>

                    <span class="section-badge">
                        ACESSO À CONTA
                    </span>

                    <h1>
                        Bem-vindo de volta
                    </h1>

                    <p>
                        Entre na sua conta para acompanhar suas reservas,
                        locações e pagamentos.
                    </p>

                </div>

                <!-- ERRO -->

                @if (!string.IsNullOrWhiteSpace(Model.MensagemErro))
                {
                    <div class="login-alert">

                        <div class="login-alert-icon">
                            !
                        </div>

                        <div>
                            <strong>
                                Não foi possível entrar
                            </strong>

                            <span>
                                @Model.MensagemErro
                            </span>
                        </div>

                    </div>
                }

                <!-- FORMULÁRIO -->

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      class="login-form">

                    @Html.AntiForgeryToken()

                    <div class="login-field">

                        <label asp-for="Email"
                               class="form-label">
                            E-mail
                        </label>

                        <div class="login-input-wrapper">

                            <span class="login-input-icon">
                                ✉
                            </span>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control login-input"
                                   placeholder="Digite seu e-mail"
                                   autocomplete="email"
                                   required />

                        </div>

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="login-field">

                        <div class="d-flex justify-content-between align-items-center">

                            <label asp-for="Senha"
                                   class="form-label mb-0">
                                Senha
                            </label>

                        </div>

                        <div class="login-input-wrapper">

                            <span class="login-input-icon">
                                ◉
                            </span>

                            <input asp-for="Senha"
                                   id="loginSenha"
                                   type="password"
                                   class="form-control login-input"
                                   placeholder="Digite sua senha"
                                   autocomplete="current-password"
                                   required />

                            <button type="button"
                                    class="login-password-toggle"
                                    id="toggleSenha"
                                    aria-label="Mostrar senha">

                                ◉

                            </button>

                        </div>

                        <span asp-validation-for="Senha"
                              class="text-danger small">
                        </span>

                    </div>

                    <button type="submit"
                            class="login-submit">

                        <span>
                            Entrar na minha conta
                        </span>

                        <span class="login-submit-arrow">
                            →
                        </span>

                    </button>

                </form>

                <!-- DIVISOR -->

                <div class="login-divider">

                    <span>
                        ou
                    </span>

                </div>

                <!-- CADASTRO -->

                <div class="login-register">

                    <div>

                        <strong>
                            Ainda não possui uma conta?
                        </strong>

                        <span>
                            Crie sua conta gratuitamente.
                        </span>

                    </div>

                    <a asp-controller="Account"
                       asp-action="Cadastro"
                       class="login-register-button">

                        Criar conta

                    </a>

                </div>

                <!-- SEGURANÇA -->

                <div class="login-security">

                    <span class="login-security-icon">
                        ✓
                    </span>

                    <span>
                        Seus dados são protegidos e utilizados
                        apenas para o funcionamento da sua conta.
                    </span>

                </div>

            </div>

        </div>

    </div>

</section>

<style>

    /* =========================================
       LOGIN
    ========================================= */

    .login-section {
        min-height: calc(100vh - 90px);
        padding: 70px 20px 90px;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .login-section::before {
        content: "";
        position: absolute;
        width: 520px;
        height: 520px;
        top: -220px;
        right: -180px;
        background: radial-gradient(
            circle,
            rgba(151, 71, 255, .16),
            transparent 70%
        );
        pointer-events: none;
    }

    .login-section::after {
        content: "";
        position: absolute;
        width: 420px;
        height: 420px;
        bottom: -220px;
        left: -180px;
        background: radial-gradient(
            circle,
            rgba(151, 71, 255, .10),
            transparent 70%
        );
        pointer-events: none;
    }

    .login-wrapper {
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }

    .login-card {
        padding: 42px;
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 22px;
        background:
            linear-gradient(
                145deg,
                rgba(27, 16, 43, .96),
                rgba(12, 7, 21, .98)
            );
        box-shadow:
            0 30px 80px rgba(0, 0, 0, .35),
            inset 0 1px 0 rgba(255, 255, 255, .04);
        backdrop-filter: blur(18px);
    }

    /* =========================================
       MARCA
    ========================================= */

    .login-brand {
        margin-bottom: 22px;
        color: #ffffff;
        font-size: 1.8rem;
        font-weight: 900;
        font-style: italic;
        letter-spacing: -1.5px;
    }

    .login-brand span {
        color: #9747ff;
    }

    /* =========================================
       CABEÇALHO
    ========================================= */

    .login-header {
        margin-bottom: 30px;
    }

    .login-header .section-badge {
        display: inline-block;
        margin-bottom: 14px;
    }

    .login-header h1 {
        margin-bottom: 10px;
        color: #ffffff;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -.7px;
    }

    .login-header p {
        margin: 0;
        color: rgba(255, 255, 255, .58);
        font-size: .94rem;
        line-height: 1.7;
    }

    /* =========================================
       ALERTA
    ========================================= */

    .login-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 24px;
        padding: 13px 15px;
        border: 1px solid rgba(220, 53, 69, .25);
        border-radius: 12px;
        background: rgba(220, 53, 69, .08);
        color: #ffffff;
    }

    .login-alert-icon {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(220, 53, 69, .18);
        color: #ff8792;
        font-size: .78rem;
        font-weight: 800;
    }

    .login-alert strong,
    .login-alert span {
        display: block;
    }

    .login-alert strong {
        margin-bottom: 2px;
        font-size: .82rem;
    }

    .login-alert span {
        color: rgba(255, 255, 255, .68);
        font-size: .78rem;
        line-height: 1.5;
    }

    /* =========================================
       CAMPOS
    ========================================= */

    .login-form {
        display: flex;
        flex-direction: column;
        gap: 21px;
    }

    .login-field .form-label {
        margin-bottom: 8px;
        color: rgba(255, 255, 255, .86);
        font-size: .82rem;
        font-weight: 700;
    }

    .login-input-wrapper {
        position: relative;
    }

    .login-input {
        min-height: 52px;
        padding: 12px 45px;
        border: 1px solid rgba(255, 255, 255, .09);
        border-radius: 12px;
        background: rgba(255, 255, 255, .035);
        color: #ffffff;
        box-shadow: none !important;
        transition: .2s ease;
    }

    .login-input::placeholder {
        color: rgba(255, 255, 255, .30);
    }

    .login-input:focus {
        border-color: rgba(151, 71, 255, .65);
        background: rgba(255, 255, 255, .055);
        color: #ffffff;
    }

    .login-input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #806e98;
        font-size: .9rem;
        z-index: 2;
        pointer-events: none;
    }

    .login-password-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        width: 34px;
        height: 34px;
        transform: translateY(-50%);
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #80758c;
        font-size: .78rem;
        cursor: pointer;
        transition: .2s ease;
    }

    .login-password-toggle:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, .06);
    }

    /* =========================================
       BOTÃO ENTRAR
    ========================================= */

    .login-submit {
        min-height: 53px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-top: 3px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(
            135deg,
            #7c2cff,
            #9747ff
        );
        color: #ffffff;
        font-size: .92rem;
        font-weight: 800;
        box-shadow: 0 12px 30px rgba(124, 44, 255, .22);
        cursor: pointer;
        transition: .2s ease;
    }

    .login-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 35px rgba(124, 44, 255, .32);
    }

    .login-submit:active {
        transform: translateY(0);
    }

    .login-submit-arrow {
        font-size: 1.15rem;
        transition: .2s ease;
    }

    .login-submit:hover .login-submit-arrow {
        transform: translateX(4px);
    }

    /* =========================================
       DIVISOR
    ========================================= */

    .login-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 28px 0 23px;
        color: rgba(255, 255, 255, .35);
        font-size: .76rem;
    }

    .login-divider::before,
    .login-divider::after {
        content: "";
        height: 1px;
        flex: 1;
        background: rgba(255, 255, 255, .08);
    }

    /* =========================================
       CADASTRO
    ========================================= */

    .login-register {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 17px;
        border: 1px solid rgba(255, 255, 255, .07);
        border-radius: 13px;
        background: rgba(255, 255, 255, .025);
    }

    .login-register strong,
    .login-register span {
        display: block;
    }

    .login-register strong {
        margin-bottom: 3px;
        color: #ffffff;
        font-size: .79rem;
    }

    .login-register span {
        color: rgba(255, 255, 255, .45);
        font-size: .71rem;
    }

    .login-register-button {
        flex-shrink: 0;
        padding: 9px 15px;
        border: 1px solid rgba(151, 71, 255, .35);
        border-radius: 9px;
        color: #ffffff;
        text-decoration: none;
        font-size: .76rem;
        font-weight: 700;
        transition: .2s ease;
    }

    .login-register-button:hover {
        border-color: #9747ff;
        background: rgba(151, 71, 255, .10);
        color: #ffffff;
    }

    /* =========================================
       SEGURANÇA
    ========================================= */

    .login-security {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 23px;
        color: rgba(255, 255, 255, .36);
        font-size: .68rem;
        line-height: 1.5;
        text-align: center;
    }

    .login-security-icon {
        width: 17px;
        height: 17px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(25, 135, 84, .18);
        color: #5fd39b;
        font-size: .65rem;
        font-weight: 800;
    }

    /* =========================================
       RESPONSIVO
    ========================================= */

    @@media (max-width: 576px) {

        .login-section {
            min-height: auto;
            padding: 40px 15px 60px;
        }

        .login-card {
            padding: 28px 21px;
            border-radius: 18px;
        }

        .login-header h1 {
            font-size: 1.65rem;
        }

        .login-register {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }

        .login-register-button {
            text-align: center;
        }

        .login-security {
            padding: 0 10px;
        }
    }

</style>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const senha =
                document.getElementById("loginSenha");

            const toggle =
                document.getElementById("toggleSenha");

            if (!senha || !toggle) {
                return;
            }

            toggle.addEventListener("click", function () {

                const mostrando =
                    senha.type === "text";

                senha.type =
                    mostrando
                        ? "password"
                        : "text";

                toggle.setAttribute(
                    "aria-label",
                    mostrando
                        ? "Mostrar senha"
                        : "Ocultar senha"
                );

            });

        });
    </script>
}