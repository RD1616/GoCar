@model List<GoCar.Web.Models.CategoriaViewModel>

@{
    ViewData["Title"] = "Categorias";

    var totalCategorias = Model.Count;

    var categoriasAtivas =
        Model.Count(c => c.IsAtivo);

    var categoriasInativas =
        Model.Count(c => !c.IsAtivo);

    var mediaDiaria =
        Model.Count > 0
            ? Model.Average(c => c.DiariaBase)
            : 0m;
}

<style>

    .categories-page {
        max-width: 1600px;
        margin: auto;
        padding: 32px;
        color: #fff;
    }

    /* HEADER */

    .categories-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .categories-eyebrow {
        margin-bottom: 4px;
        color: #a99fb4;
        font-size: .90rem;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .categories-title {
        margin: 0;
        color: #fff;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .categories-description {
        margin: 6px 0 0;
        color: #aaa0b5;
        font-size: .96rem;
    }

    .categories-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
    }

    .category-primary-btn,
    .category-secondary-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 15px;
        border-radius: 8px;
        text-decoration: none;
        font-size: .90rem;
        font-weight: 700;
        transition: .18s ease;
    }

    .category-primary-btn {
        border: 1px solid #8b3dff;
        background: linear-gradient( 135deg, #7c2cff, #9b4dff );
        color: #fff;
        box-shadow: 0 8px 25px rgba(126,44,255,.18);
    }

        .category-primary-btn:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .category-secondary-btn {
        border: 1px solid rgba(151,71,255,.24);
        background: rgba(126,44,255,.06);
        color: #fff;
    }

        .category-secondary-btn:hover {
            color: #fff;
            background: rgba(126,44,255,.12);
            border-color: rgba(151,71,255,.45);
        }

    /* RESUMO */

    .categories-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 13px;
        margin-bottom: 18px;
    }

    .category-summary-card {
        position: relative;
        overflow: hidden;
        padding: 16px 17px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 10px;
        background: linear-gradient( 145deg, rgba(24,13,41,.96), rgba(14,8,25,.96) );
    }

        .category-summary-card::after {
            content: "";
            position: absolute;
            width: 75px;
            height: 75px;
            right: -35px;
            top: -35px;
            border-radius: 50%;
            background: rgba(139,51,255,.07);
        }

    .category-summary-label {
        color: #aaa0b5;
        font-size: .86rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .category-summary-value {
        margin-top: 5px;
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
    }

    .category-summary-money {
        color: #c084fc;
    }

    /* FILTROS */

    .categories-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 16px;
        padding: 14px 16px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 10px;
        background: linear-gradient( 145deg, rgba(21,11,37,.97), rgba(13,7,24,.97) );
    }

    .categories-search {
        width: min(450px, 100%);
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 13px;
        border: 1px solid rgba(151,71,255,.18);
        border-radius: 8px;
        background: rgba(255,255,255,.025);
    }

        .categories-search span {
            color: #b6aabd;
        }

        .categories-search input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            color: #fff;
            font-size: .92rem;
        }

            .categories-search input::placeholder {
                color: #8e8499;
            }

    .categories-toolbar-right {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .categories-count {
        color: #aaa0b5;
        font-size: .88rem;
        white-space: nowrap;
    }

        .categories-count strong {
            color: #fff;
        }

    .categories-filter {
        padding: 9px 12px;
        border: 1px solid rgba(151,71,255,.18);
        border-radius: 8px;
        outline: none;
        background: #130b20;
        color: #ddd5e4;
        font-size: .90rem;
    }

    /* TABELA */

    .categories-table-card {
        overflow: hidden;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
    }

    .categories-table-wrap {
        overflow-x: auto;
    }

    .categories-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
    }

        .categories-table thead {
            background: rgba(126,44,255,.055);
        }

        .categories-table th {
            padding: 13px 15px;
            border-bottom: 1px solid rgba(151,71,255,.13);
            color: #a99fb4;
            font-size: .82rem;
            font-weight: 700;
            text-align: left;
            text-transform: uppercase;
            letter-spacing: .45px;
            white-space: nowrap;
        }

        .categories-table td {
            padding: 14px 15px;
            border-bottom: 1px solid rgba(255,255,255,.04);
            color: #d1cad8;
            font-size: .90rem;
            vertical-align: middle;
        }

        .categories-table tbody tr {
            transition: .15s ease;
        }

            .categories-table tbody tr:hover {
                background: rgba(126,44,255,.035);
            }

            .categories-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .category-id {
        color: #a99fb4;
        font-weight: 700;
    }

    .category-name {
        color: #fff;
        font-size: .94rem;
        font-weight: 700;
    }

    .category-description {
        max-width: 280px;
        color: #b7adbf;
        line-height: 1.45;
    }

    .category-price {
        color: #d8c6ee;
        font-weight: 700;
        white-space: nowrap;
    }

    .category-km {
        color: #c6bdcf;
        white-space: nowrap;
    }

    /* STATUS */

    .category-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .category-status::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: currentColor;
        }

    .category-status-active {
        color: #3ce78c;
        background: rgba(26,192,103,.12);
    }

    .category-status-inactive {
        color: #b4aabd;
        background: rgba(148,163,184,.10);
    }

    /* AÇÕES */

    .category-row-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .category-action {
        min-height: 31px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 10px;
        border: 1px solid rgba(151,71,255,.18);
        border-radius: 6px;
        background: rgba(255,255,255,.02);
        color: #fff;
        text-decoration: none;
        font-size: .82rem;
        font-weight: 700;
        transition: .15s ease;
        cursor: pointer;
    }

        .category-action:hover {
            color: #fff;
            border-color: rgba(151,71,255,.4);
            background: rgba(126,44,255,.09);
        }

    .category-action-edit {
        color: #fff;
        background: rgba(126,44,255,.10);
    }

    .category-action-danger {
        color: #ff718d;
        border-color: rgba(244,63,94,.18);
        background: rgba(244,63,94,.055);
    }

        .category-action-danger:hover {
            color: #ff9bae;
            border-color: rgba(244,63,94,.4);
            background: rgba(244,63,94,.10);
        }

    .category-action-success {
        color: #3ce78c;
        border-color: rgba(26,192,103,.20);
        background: rgba(26,192,103,.06);
    }

        .category-action-success:hover {
            color: #65f3a5;
            border-color: rgba(26,192,103,.4);
            background: rgba(26,192,103,.10);
        }

    .category-action-form {
        margin: 0;
    }

    /* VAZIO */

    .categories-empty {
        padding: 55px 25px;
        text-align: center;
    }

    .categories-empty-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 13px;
        border-radius: 50%;
        color: #a855f7;
        background: rgba(139,51,255,.12);
        font-size: 1.1rem;
    }

    .categories-empty h3 {
        margin-bottom: 6px;
        color: #fff;
        font-size: 1rem;
    }

    .categories-empty p {
        margin: 0;
        color: #aaa0b5;
        font-size: .90rem;
    }

    .category-hidden {
        display: none !important;
    }

    @@media (max-width: 1000px) {

        .categories-summary {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {

        .categories-page {
            padding: 20px 15px;
        }

        .categories-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .categories-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .categories-search {
            width: 100%;
        }

        .categories-toolbar-right {
            justify-content: space-between;
        }
    }

</style>


<div class="categories-page">

    <div class="categories-header">

        <div>

            <div class="categories-eyebrow">
                Gestão da frota
            </div>

            <h1 class="categories-title">
                Categorias
            </h1>

            <p class="categories-description">
                Gerencie as categorias, valores de diária e franquias de quilometragem.
            </p>

        </div>


        <div class="categories-actions">

            <a asp-controller="Categorias"
               asp-action="Criar"
               class="category-primary-btn">

                + Nova Categoria

            </a>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="category-secondary-btn">

                ← Dashboard

            </a>

        </div>

    </div>


    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Erro"]
        </div>
    }

    @if (ViewBag.MensagemErro != null)
    {
        <div class="alert alert-danger">
            @ViewBag.MensagemErro
        </div>
    }


    <div class="categories-summary">

        <div class="category-summary-card">

            <div class="category-summary-label">
                Total
            </div>

            <div class="category-summary-value">
                @totalCategorias
            </div>

        </div>


        <div class="category-summary-card">

            <div class="category-summary-label">
                Ativas
            </div>

            <div class="category-summary-value">
                @categoriasAtivas
            </div>

        </div>


        <div class="category-summary-card">

            <div class="category-summary-label">
                Inativas
            </div>

            <div class="category-summary-value">
                @categoriasInativas
            </div>

        </div>


        <div class="category-summary-card">

            <div class="category-summary-label">
                Diária média
            </div>

            <div class="
                category-summary-value
                category-summary-money">

                @(mediaDiaria.ToString("C"))

            </div>

        </div>

    </div>


    <div class="categories-toolbar">

        <div class="categories-search">

            <span>⌕</span>

            <input id="categorySearch"
                   type="text"
                   placeholder="Buscar por nome ou descrição..." />

        </div>


        <div class="categories-toolbar-right">

            <span class="categories-count">

                <strong id="categoryCount">
                    @Model.Count
                </strong>

                categorias

            </span>


            <select id="categoryStatusFilter"
                    class="categories-filter">

                <option value="">
                    Todos os status
                </option>

                <option value="ativa">
                    Ativas
                </option>

                <option value="inativa">
                    Inativas
                </option>

            </select>

        </div>

    </div>


    <div class="categories-table-card">

        @if (Model.Count > 0)
        {
            <div class="categories-table-wrap">

                <table class="categories-table">

                    <thead>

                        <tr>
                            <th>ID</th>
                            <th>Categoria</th>
                            <th>Descrição</th>
                            <th>Diária Base</th>
                            <th>KM Livre</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var categoria in Model)
                        {
                            var statusFiltro =
                                categoria.IsAtivo
                                    ? "ativa"
                                    : "inativa";

                            var textoBusca =
                                $"{categoria.Id} " +
                                $"{categoria.Nome} " +
                                $"{categoria.Descricao}";


                            <tr class="category-item"
                                data-status="@statusFiltro"
                                data-search="@textoBusca">

                                <td>
                                    <span class="category-id">
                                        #@categoria.Id
                                    </span>
                                </td>


                                <td>
                                    <span class="category-name">
                                        @categoria.Nome
                                    </span>
                                </td>


                                <td>
                                    <div class="category-description">

                                        @if (string.IsNullOrWhiteSpace(
                                            categoria.Descricao))
                                        {
                                            <span>
                                                Sem descrição
                                            </span>
                                        }
                                        else
                                        {
                                            @categoria.Descricao
                                        }

                                    </div>
                                </td>


                                <td>
                                    <span class="category-price">
                                        @(categoria.DiariaBase.ToString("C"))
                                    </span>
                                </td>


                                <td>
                                    <span class="category-km">
                                        @categoria.KmLivre km
                                    </span>
                                </td>


                                <td>

                                    @if (categoria.IsAtivo)
                                    {
                                        <span class="
                                            category-status
                                            category-status-active">

                                            Ativa

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="
                                            category-status
                                            category-status-inactive">

                                            Inativa

                                        </span>
                                    }

                                </td>


                                <td>

                                    <div class="category-row-actions">

                                        <a asp-controller="Categorias"
                                           asp-action="Detalhes"
                                           asp-route-id="@categoria.Id"
                                           class="category-action">

                                            Visualizar

                                        </a>


                                        <a asp-controller="Categorias"
                                           asp-action="Editar"
                                           asp-route-id="@categoria.Id"
                                           class="
                                            category-action
                                            category-action-edit">

                                            Editar

                                        </a>


                                        @if (categoria.IsAtivo)
                                        {
                                            <form asp-controller="Categorias"
                                                  asp-action="Desativar"
                                                  asp-route-id="@categoria.Id"
                                                  method="post"
                                                  class="category-action-form"
                                                  onsubmit="return confirm('Deseja realmente desativar esta categoria?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="
                                                    category-action
                                                    category-action-danger">

                                                    Desativar

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Categorias"
                                                  asp-action="Ativar"
                                                  asp-route-id="@categoria.Id"
                                                  method="post"
                                                  class="category-action-form"
                                                  onsubmit="return confirm('Deseja reativar esta categoria?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="
                                                    category-action
                                                    category-action-success">

                                                    Ativar

                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div id="categoryNoResults"
                 class="categories-empty d-none">

                <div class="categories-empty-icon">
                    ◇
                </div>

                <h3>
                    Nenhuma categoria encontrada
                </h3>

                <p>
                    Nenhuma categoria corresponde aos filtros selecionados.
                </p>

            </div>
        }
        else
        {
            <div class="categories-empty">

                <div class="categories-empty-icon">
                    ◇
                </div>

                <h3>
                    Nenhuma categoria encontrada
                </h3>

                <p>
                    Ainda não existem categorias cadastradas.
                </p>

            </div>
        }

    </div>

</div>


@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const search =
                    document.getElementById(
                        "categorySearch"
                    );

                const statusFilter =
                    document.getElementById(
                        "categoryStatusFilter"
                    );

                const count =
                    document.getElementById(
                        "categoryCount"
                    );

                const noResults =
                    document.getElementById(
                        "categoryNoResults"
                    );

                const items =
                    document.querySelectorAll(
                        ".category-item"
                    );


                function normalizarTexto(texto) {

                    return (texto || "")
                        .toLowerCase()
                        .normalize("NFD")
                        .replace(
                            /[\u0300-\u036f]/g,
                            ""
                        );
                }


                function filtrarCategorias() {

                    const texto =
                        normalizarTexto(
                            search?.value.trim()
                        );

                    const status =
                        statusFilter?.value || "";

                    let visiveis = 0;


                    items.forEach(
                        function(item) {

                            const dados =
                                normalizarTexto(
                                    item.dataset.search
                                );

                            const statusItem =
                                item.dataset.status
                                || "";


                            const correspondeTexto =
                                !texto ||
                                dados.includes(texto);


                            const correspondeStatus =
                                !status ||
                                statusItem === status;


                            const mostrar =
                                correspondeTexto &&
                                correspondeStatus;


                            item.classList.toggle(
                                "category-hidden",
                                !mostrar
                            );


                            if (mostrar) {
                                visiveis++;
                            }

                        }
                    );


                    if (count) {
                        count.textContent =
                            visiveis;
                    }


                    if (noResults) {

                        noResults.classList.toggle(
                            "d-none",
                            visiveis > 0
                        );
                    }

                }


                search?.addEventListener(
                    "input",
                    filtrarCategorias
                );


                statusFilter?.addEventListener(
                    "change",
                    filtrarCategorias
                );

            }
        );

    </script>
}