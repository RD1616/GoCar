@model GoCar.Web.Models.ReservaViewModel
@using GoCar.Web.Models

@{
    ViewData["Title"] = "Detalhes da Reserva";

    bool modoAdministrador =
        ViewBag.ModoAdministrador == true;

    decimal valorEntrada =
        ViewBag.ValorEntrada != null
            ? (decimal)ViewBag.ValorEntrada
            : Math.Round(
                Model.ValorPrevisto * 0.30m,
                2,
                MidpointRounding.AwayFromZero);

    decimal saldoRestante =
        Math.Round(
            Model.ValorPrevisto - valorEntrada,
            2,
            MidpointRounding.AwayFromZero);

    bool entradaPaga =
        ViewBag.EntradaPaga == true;

    PagamentoViewModel? pagamentoEntrada =
        ViewBag.PagamentoEntrada as PagamentoViewModel;

    bool podeCancelar =
        Model.IsAtiva &&
        (Model.Status == 1 || Model.Status == 2);

    // =====================================================
    // CONTROLE DA DATA DE RETIRADA
    // =====================================================

    bool diaDaRetiradaChegou =
        DateTime.Now.Date >= Model.DataRetirada.Date;

    bool periodoDaReservaTerminou =
        DateTime.Now > Model.DataDevolucaoPrevista;

    bool podeIniciarLocacao =
        modoAdministrador &&
        Model.Status == 2 &&
        Model.IsAtiva &&
        entradaPaga &&
        diaDaRetiradaChegou &&
        !periodoDaReservaTerminou;

    string StatusReserva(int status)
    {
        return status switch
        {
            1 => "Pendente",
            2 => "Confirmada",
            3 => "Cancelada",
            4 => "Expirada",
            5 => "Concluída",
            _ => "Desconhecido"
        };
    }

    string FormaPagamento(int forma)
    {
        return forma switch
        {
            1 => "Pix",
            2 => "Cartão de Crédito",
            3 => "Cartão de Débito",
            4 => "Dinheiro",
            _ => "Não informado"
        };
    }
}

<style>

    .reservation-details-page {
        max-width: 1500px;
        margin: auto;
        padding: 32px;
        color: #fff;
    }

    .reservation-details-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .reservation-details-eyebrow {
        margin-bottom: 4px;
        color: #a99fb4;
        font-size: .90rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .reservation-details-title {
        margin: 0;
        color: #fff;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .reservation-details-description {
        margin: 6px 0 0;
        color: #aaa0b5;
        font-size: .96rem;
    }

    .reservation-back-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 16px;
        border: 1px solid rgba(151,71,255,.24);
        border-radius: 8px;
        background: rgba(126,44,255,.06);
        color: #fff;
        text-decoration: none;
        font-size: .90rem;
        font-weight: 700;
        transition: .18s ease;
    }

        .reservation-back-btn:hover {
            color: #fff;
            background: rgba(126,44,255,.12);
            border-color: rgba(151,71,255,.45);
        }

    .reservation-details-page .alert {
        border-radius: 9px;
        font-size: .90rem;
        line-height: 1.55;
    }

        .reservation-details-page .alert strong {
            font-size: .92rem;
        }

    .reservation-flow-alert {
        padding: 15px 17px;
    }

    .reservation-details-card {
        margin-bottom: 18px;
        padding: 22px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: radial-gradient( circle at 92% 8%, rgba(126,44,255,.08), transparent 28% ), linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
    }

    .reservation-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 20px;
    }

    .reservation-card-label {
        display: block;
        margin-bottom: 3px;
        color: #aaa0b5;
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .reservation-card-number {
        margin: 0;
        color: #fff;
        font-size: 1.35rem;
        font-weight: 800;
    }

    .reservation-badges {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .reservation-details-page .badge {
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 700;
    }

    .reservation-divider {
        margin: 20px 0;
        border: 0;
        border-top: 1px solid rgba(255,255,255,.07);
        opacity: 1;
    }

    .reservation-info-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 20px;
    }

    .reservation-col-4 {
        grid-column: span 4;
    }

    .reservation-col-6 {
        grid-column: span 6;
    }

    .reservation-col-12 {
        grid-column: span 12;
    }

    .reservation-field-label {
        display: block;
        margin-bottom: 5px;
        color: #aaa0b5;
        font-size: .84rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .reservation-field-value {
        margin: 0;
        color: #e3dce9;
        font-size: .92rem;
        font-weight: 600;
        line-height: 1.5;
    }

    .reservation-field-value-strong {
        font-weight: 800;
    }

    .reservation-field-sub {
        display: block;
        margin-top: 3px;
        color: #91879d;
        font-size: .82rem;
    }

    .reservation-cancel-area {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
    }

    .reservation-cancel-text {
        color: #aaa0b5;
        font-size: .88rem;
        line-height: 1.5;
    }

    .reservation-cancel-warning {
        color: #f6c85f;
    }

    .reservation-danger-btn {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 14px;
        border: 1px solid rgba(244,63,94,.45);
        border-radius: 7px;
        background: rgba(244,63,94,.14);
        color: #ff91a7;
        font-size: .88rem;
        font-weight: 700;
        transition: .15s ease;
    }

        .reservation-danger-btn:hover {
            background: rgba(244,63,94,.22);
            color: #fff;
        }

    .reservation-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 20px;
    }

    .reservation-section-badge {
        display: inline-block;
        margin-bottom: 5px;
        color: #b99adf;
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .reservation-section-title {
        margin: 0;
        color: #fff;
        font-size: 1.08rem;
        font-weight: 750;
    }

    .reservation-section-description {
        margin: 6px 0 0;
        color: #aaa0b5;
        font-size: .90rem;
        line-height: 1.5;
    }

    .reservation-money-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .reservation-money-box {
        padding: 14px;
        border: 1px solid rgba(151,71,255,.11);
        border-radius: 8px;
        background: rgba(255,255,255,.018);
    }

    .reservation-money-label {
        display: block;
        margin-bottom: 5px;
        color: #aaa0b5;
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .reservation-money-value {
        margin: 0;
        color: #fff;
        font-size: 1rem;
        font-weight: 800;
    }

    .reservation-money-value-large {
        font-size: 1.12rem;
    }

    .reservation-money-note {
        display: block;
        margin-top: 4px;
        color: #91879d;
        font-size: .82rem;
    }

    .reservation-money-note-success {
        color: #3ce78c;
    }

    .reservation-money-note-warning {
        color: #fbbf24;
    }

    .reservation-payment-info {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 18px;
    }

    .reservation-payment-form {
        margin-top: 4px;
    }

    .reservation-form-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0,1fr));
        gap: 16px;
        align-items: end;
    }

    .reservation-form-col-6 {
        grid-column: span 6;
    }

    .reservation-form-col-12 {
        grid-column: span 12;
    }

    .reservation-details-page .form-label {
        margin-bottom: 7px;
        color: #c3bacb;
        font-size: .88rem;
        font-weight: 700;
    }

    .reservation-details-page .form-control,
    .reservation-details-page .form-select {
        min-height: 42px;
        border: 1px solid rgba(151,71,255,.17);
        border-radius: 7px;
        background-color: rgba(255,255,255,.025);
        color: #ded8e5;
        font-size: .90rem;
    }

        .reservation-details-page .form-control:focus,
        .reservation-details-page .form-select:focus {
            border-color: rgba(151,71,255,.65);
            background-color: rgba(126,44,255,.045);
            color: #fff;
            box-shadow: 0 0 0 3px rgba(126,44,255,.07);
        }

        .reservation-details-page .form-select option {
            background: #160d25;
            color: #fff;
        }

    .reservation-details-page textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .reservation-success-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 16px;
        border: 1px solid rgba(34,197,94,.55);
        border-radius: 7px;
        background: linear-gradient( 135deg, rgba(22,163,74,.95), rgba(34,197,94,.95) );
        color: #fff;
        font-size: .90rem;
        font-weight: 700;
        transition: .15s ease;
    }

        .reservation-success-btn:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .reservation-success-btn-full {
        width: 100%;
    }

    .reservation-final-alert {
        margin-bottom: 18px;
    }

    @@media (max-width: 850px) {

        .reservation-details-page {
            padding: 20px 15px;
        }

        .reservation-details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .reservation-back-btn {
            width: 100%;
        }

        .reservation-col-4,
        .reservation-col-6 {
            grid-column: span 12;
        }

        .reservation-money-grid,
        .reservation-payment-info {
            grid-template-columns: 1fr;
        }

        .reservation-form-col-6 {
            grid-column: span 12;
        }

        .reservation-cancel-area {
            align-items: stretch;
            flex-direction: column;
        }

        .reservation-danger-btn {
            width: 100%;
        }
    }

    @@media (max-width: 600px) {

        .reservation-card-header,
        .reservation-section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .reservation-details-card {
            padding: 17px;
        }
    }

</style>


<div class="reservation-details-page">

    <div class="reservation-details-header">

        <div>

            <div class="reservation-details-eyebrow">

                @(modoAdministrador
                    ? "Área administrativa"
                    : "Minha reserva")

            </div>

            <h1 class="reservation-details-title">
                Reserva #@Model.Id
            </h1>

            <p class="reservation-details-description">

                @(modoAdministrador
                    ? "Acompanhe o pagamento e a liberação do veículo."
                    : "Acompanhe sua reserva, pagamento e retirada.")

            </p>

        </div>

        <a asp-controller="Reservas"
           asp-action="Index"
           class="reservation-back-btn">

            ← Voltar

        </a>

    </div>


    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger mb-4">
            @TempData["Erro"]
        </div>
    }


    <!-- ========================================= -->
    <!-- STATUS DO FLUXO -->
    <!-- ========================================= -->
    @if (Model.Status == 1 &&
             Model.IsAtiva &&
             !entradaPaga)
    {
        <div class="alert alert-warning reservation-flow-alert mb-4">

            <strong>
                Aguardando pagamento da entrada
            </strong>

            <div class="mt-1">

                @if (modoAdministrador)
                {
                    <span>
                        O cliente precisa pagar a entrada de
                        <strong>
                            @valorEntrada.ToString("C")
                        </strong>
                        para confirmar a reserva.
                    </span>
                }
                else
                {
                    <span>
                        Pague a entrada de
                        <strong>
                            @valorEntrada.ToString("C")
                        </strong>
                        para confirmar sua reserva.
                    </span>
                }

            </div>

        </div>
    }


    @if (Model.Status == 2 &&
         Model.IsAtiva &&
         entradaPaga)
    {
        @if (!diaDaRetiradaChegou)
        {
            <div class="alert alert-info reservation-flow-alert mb-4">

                <strong>
                    Reserva confirmada — entrada paga
                </strong>

                <div class="mt-1">

                    Retirada agendada para

                    <strong>
                        @Model.DataRetirada.ToString("dd/MM/yyyy 'às' HH:mm")
                    </strong>.

                </div>

            </div>
        }
        else if (periodoDaReservaTerminou)
        {
            <div class="alert alert-warning reservation-flow-alert mb-4">

                <strong>
                    Período da reserva encerrado
                </strong>

                <div class="mt-1">
                    Esta reserva não pode mais ter uma locação iniciada.
                </div>

            </div>
        }
        else
        {
            <div class="alert alert-success reservation-flow-alert mb-4">

                <strong>
                    Reserva confirmada — entrada paga
                </strong>

                <div class="mt-1">

                    @if (modoAdministrador)
                    {
                        <span>
                            O pagamento de 30% foi confirmado.
                            O veículo está liberado para retirada.
                        </span>
                    }
                    else
                    {
                        <span>
                            Seu pagamento foi confirmado.
                            O veículo está liberado para retirada.
                        </span>
                    }

                </div>

            </div>
        }
    }


    <!-- ========================================= -->
    <!-- DADOS DA RESERVA -->
    <!-- ========================================= -->

    <div class="reservation-details-card">

        <div class="reservation-card-header">

            <div>

                <span class="reservation-card-label">
                    Reserva
                </span>

                <h2 class="reservation-card-number">
                    #@Model.Id
                </h2>

            </div>


            <div class="reservation-badges">

                @if (Model.Status == 1)
                {
                    <span class="badge bg-warning text-dark">
                        Pendente
                    </span>
                }
                else if (Model.Status == 2)
                {
                    <span class="badge bg-success">
                        Confirmada
                    </span>
                }
                else if (Model.Status == 3)
                {
                    <span class="badge bg-danger">
                        Cancelada
                    </span>
                }
                else if (Model.Status == 4)
                {
                    <span class="badge bg-secondary">
                        Expirada
                    </span>
                }
                else if (Model.Status == 5)
                {
                    <span class="badge bg-primary">
                        Concluída
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        @StatusReserva(Model.Status)
                    </span>
                }


                @if (entradaPaga)
                {
                    <span class="badge bg-success">
                        Entrada paga
                    </span>
                }

            </div>

        </div>


        <hr class="reservation-divider" />


        <div class="reservation-info-grid">

            <div class="reservation-col-4">

                <span class="reservation-field-label">
                    Cliente
                </span>

                <p class="reservation-field-value reservation-field-value-strong">

                    @(string.IsNullOrWhiteSpace(Model.ClienteNome)
                        ? $"Cliente #{Model.ClienteId}"
                        : Model.ClienteNome)

                </p>

                @if (modoAdministrador)
                {
                    <span class="reservation-field-sub">
                        Código #@Model.ClienteId
                    </span>
                }

            </div>


            <div class="reservation-col-4">

                <span class="reservation-field-label">
                    Veículo
                </span>

                <p class="reservation-field-value reservation-field-value-strong">

                    @(string.IsNullOrWhiteSpace(Model.VeiculoNome)
                        ? $"Veículo #{Model.VeiculoId}"
                        : Model.VeiculoNome)

                </p>

                @if (!string.IsNullOrWhiteSpace(Model.VeiculoPlaca))
                {
                    <span class="reservation-field-sub">
                        Placa @Model.VeiculoPlaca
                    </span>
                }

            </div>


            <div class="reservation-col-4">

                <span class="reservation-field-label">
                    Status
                </span>

                <p class="reservation-field-value">
                    @StatusReserva(Model.Status)
                </p>

            </div>


            <div class="reservation-col-6">

                <span class="reservation-field-label">
                    Data de retirada
                </span>

                <p class="reservation-field-value">
                    @Model.DataRetirada.ToString("dd/MM/yyyy HH:mm")
                </p>

            </div>


            <div class="reservation-col-6">

                <span class="reservation-field-label">
                    Devolução prevista
                </span>

                <p class="reservation-field-value">
                    @Model.DataDevolucaoPrevista.ToString("dd/MM/yyyy HH:mm")
                </p>

            </div>


            <div class="reservation-col-6">

                <span class="reservation-field-label">
                    Filial de retirada
                </span>

                <p class="reservation-field-value reservation-field-value-strong">

                    @(string.IsNullOrWhiteSpace(Model.FilialRetiradaNome)
                        ? $"Filial #{Model.FilialRetiradaId}"
                        : Model.FilialRetiradaNome)

                </p>

            </div>


            <div class="reservation-col-6">

                <span class="reservation-field-label">
                    Filial de devolução
                </span>

                <p class="reservation-field-value reservation-field-value-strong">

                    @(string.IsNullOrWhiteSpace(Model.FilialDevolucaoNome)
                        ? $"Filial #{Model.FilialDevolucaoId}"
                        : Model.FilialDevolucaoNome)

                </p>

            </div>


            <div class="reservation-col-4">

                <span class="reservation-field-label">
                    Valor total
                </span>

                <p class="reservation-field-value reservation-field-value-strong">
                    @Model.ValorPrevisto.ToString("C")
                </p>

            </div>


            <div class="reservation-col-4">

                <span class="reservation-field-label">
                    Situação
                </span>

                <p class="reservation-field-value">

                    @if (Model.IsAtiva)
                    {
                        <span class="badge bg-success">
                            Ativa
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inativa
                        </span>
                    }

                </p>

            </div>


            <div class="reservation-col-4">

                <span class="reservation-field-label">
                    Data da reserva
                </span>

                <p class="reservation-field-value">
                    @Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                </p>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.Observacoes))
            {
                <div class="reservation-col-12">

                    <span class="reservation-field-label">
                        Observações
                    </span>

                    <p class="reservation-field-value">
                        @Model.Observacoes
                    </p>

                </div>
            }


            @if (Model.DataCancelamento.HasValue)
            {
                <div class="reservation-col-4">

                    <span class="reservation-field-label">
                        Data de cancelamento
                    </span>

                    <p class="reservation-field-value">
                        @Model.DataCancelamento.Value.ToString("dd/MM/yyyy HH:mm")
                    </p>

                </div>
            }

        </div>


        <!-- ===================================== -->
        <!-- CANCELAMENTO -->
        <!-- ===================================== -->
        @if (podeCancelar)
        {
            <hr class="reservation-divider" />

            <div class="reservation-cancel-area">

                <div>

                    @if (entradaPaga)
                    {
                        <div class="reservation-cancel-text reservation-cancel-warning">

                            A entrada já foi paga. O cancelamento
                            não remove o histórico do pagamento.

                        </div>
                    }
                    else
                    {
                        <div class="reservation-cancel-text">

                            Você pode cancelar esta reserva
                            antes da retirada do veículo.

                        </div>
                    }

                </div>


                @if (modoAdministrador)
                {
                    <form asp-controller="Reservas"
                          asp-action="Cancelar"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Deseja realmente cancelar esta reserva?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="reservation-danger-btn">

                            Cancelar Reserva

                        </button>

                    </form>
                }
                else
                {
                    <form asp-controller="Reservas"
                          asp-action="CancelarMinhaReserva"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Deseja realmente cancelar sua reserva?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="reservation-danger-btn">

                            Cancelar minha reserva

                        </button>

                    </form>
                }

            </div>
        }

    </div>


    <!-- ========================================= -->
    <!-- PAGAMENTO DA ENTRADA -->
    <!-- ========================================= -->
    @if ((Model.Status == 1 ||
              Model.Status == 2) &&
              Model.IsAtiva)
    {
        <div class="reservation-details-card">

            <div class="reservation-section-heading">

                <div>

                    <span class="reservation-section-badge">
                        Pagamento
                    </span>

                    <h3 class="reservation-section-title">
                        Entrada da reserva
                    </h3>

                    <p class="reservation-section-description">

                        A entrada corresponde a 30% do valor total da reserva.

                    </p>

                </div>


                @if (entradaPaga)
                {
                    <span class="badge bg-success">
                        Entrada paga
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">
                        Aguardando pagamento
                    </span>
                }

            </div>


            <div class="reservation-money-grid">

                <div class="reservation-money-box">

                    <span class="reservation-money-label">
                        Valor total da reserva
                    </span>

                    <p class="reservation-money-value">
                        @Model.ValorPrevisto.ToString("C")
                    </p>

                </div>


                <div class="reservation-money-box">

                    <span class="reservation-money-label">
                        Entrada de 30%
                    </span>

                    <p class="reservation-money-value reservation-money-value-large">
                        @valorEntrada.ToString("C")
                    </p>


                    @if (entradaPaga)
                    {
                        <span class="reservation-money-note reservation-money-note-success">
                            ✓ Pago
                        </span>
                    }
                    else
                    {
                        <span class="reservation-money-note reservation-money-note-warning">
                            Aguardando pagamento
                        </span>
                    }

                </div>


                <div class="reservation-money-box">

                    <span class="reservation-money-label">
                        Saldo restante
                    </span>

                    <p class="reservation-money-value reservation-money-value-large">
                        @saldoRestante.ToString("C")
                    </p>

                    <span class="reservation-money-note">
                        70% restante
                    </span>

                </div>

            </div>


            <!-- ================================= -->
            <!-- ENTRADA JÁ PAGA -->
            <!-- ================================= -->
            @if (entradaPaga &&
                             pagamentoEntrada != null)
            {
                <hr class="reservation-divider" />


                <div class="reservation-payment-info">

                    <div>

                        <span class="reservation-field-label">
                            Status do pagamento
                        </span>

                        <p class="reservation-field-value">

                            <span class="badge bg-success">
                                Pago
                            </span>

                        </p>

                    </div>


                    <div>

                        <span class="reservation-field-label">
                            Forma de pagamento
                        </span>

                        <p class="reservation-field-value reservation-field-value-strong">

                            @FormaPagamento(
                                pagamentoEntrada.FormaPagamento)

                        </p>

                    </div>


                    <div>

                        <span class="reservation-field-label">
                            Data do pagamento
                        </span>

                        <p class="reservation-field-value">

                            @(pagamentoEntrada.DataPagamento.HasValue
                                ? pagamentoEntrada.DataPagamento.Value
                                    .ToString("dd/MM/yyyy HH:mm")
                                : "-")

                        </p>

                    </div>

                </div>


                <div class="alert alert-success mt-4 mb-0">

                    <strong>
                        Entrada confirmada.
                    </strong>

                    O valor de

                    <strong>
                        @valorEntrada.ToString("C")
                    </strong>

                    já foi pago.

                    Restam

                    <strong>
                        @saldoRestante.ToString("C")
                    </strong>

                    do valor da locação.

                </div>
            }


            <!-- ================================= -->
            <!-- CLIENTE PAGA ENQUANTO PENDENTE -->
            <!-- ================================= -->
            @if (!entradaPaga &&
                             !modoAdministrador &&
                             Model.Status == 1)
            {
                <hr class="reservation-divider" />


                <form asp-controller="Reservas"
                      asp-action="PagarEntrada"
                      method="post"
                      class="reservation-payment-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />


                    <div class="reservation-form-grid">

                        <div class="reservation-form-col-6">

                            <label class="form-label">
                                Forma de pagamento
                            </label>

                            <select name="formaPagamento"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Selecione...
                                </option>

                                <option value="1">
                                    Pix
                                </option>

                                <option value="2">
                                    Cartão de Crédito
                                </option>

                                <option value="3">
                                    Cartão de Débito
                                </option>

                                <option value="4">
                                    Dinheiro
                                </option>

                            </select>

                        </div>


                        <div class="reservation-form-col-6">

                            <button type="submit"
                                    class="reservation-success-btn reservation-success-btn-full"
                                    onclick="return confirm('Confirmar o pagamento da entrada?');">

                                Pagar entrada de
                                @valorEntrada.ToString("C")

                            </button>

                        </div>

                    </div>

                </form>


                <div class="alert alert-info mt-4 mb-0">

                    Neste projeto, o pagamento é simulado.

                    Após o pagamento dos 30%, sua reserva será

                    <strong>
                        confirmada automaticamente.
                    </strong>

                </div>
            }


            <!-- ================================= -->
            <!-- ADMIN AGUARDANDO CLIENTE -->
            <!-- ================================= -->
            @if (!entradaPaga &&
                             modoAdministrador)
            {
                <hr class="reservation-divider" />

                <div class="alert alert-warning mb-0">

                    <strong>
                        Aguardando pagamento.
                    </strong>

                    O cliente precisa pagar

                    <strong>
                        @valorEntrada.ToString("C")
                    </strong>

                    antes que a locação possa ser iniciada.

                </div>
            }

        </div>
    }


    <!-- ========================================= -->
    <!-- INICIAR LOCAÇÃO - FUNCIONÁRIO -->
    <!-- ========================================= -->
    @if (modoAdministrador &&
             Model.Status == 2 &&
             Model.IsAtiva)
    {
        <div class="reservation-details-card">

            <div class="reservation-section-heading">

                <div>

                    <span class="reservation-section-badge">
                        Retirada
                    </span>

                    <h3 class="reservation-section-title">
                        Iniciar locação
                    </h3>


                    @if (!entradaPaga)
                    {
                        <p class="reservation-section-description">

                            A locação permanece bloqueada enquanto
                            a entrada não estiver paga.

                        </p>
                    }
                    else if (!diaDaRetiradaChegou)
                    {
                        <p class="reservation-section-description">

                            A reserva está confirmada.
                            Aguarde a data programada para realizar a retirada.

                        </p>
                    }
                    else if (periodoDaReservaTerminou)
                    {
                        <p class="reservation-section-description">

                            O período programado desta reserva já terminou.

                        </p>
                    }
                    else
                    {
                        <p class="reservation-section-description">

                            A entrada foi paga.
                            Informe os dados do veículo no momento da retirada.

                        </p>
                    }

                </div>

            </div>


            @if (!entradaPaga)
            {
                <div class="alert alert-warning mb-0">

                    <strong>
                        Locação bloqueada.
                    </strong>

                    O cliente precisa pagar a entrada de

                    <strong>
                        @valorEntrada.ToString("C")
                    </strong>

                    antes da retirada.

                </div>
            }
            else if (!diaDaRetiradaChegou)
            {
                <div class="alert alert-info mb-0">

                    <strong>
                        Retirada agendada.
                    </strong>

                    Esta locação poderá ser iniciada a partir de

                    <strong>
                        @Model.DataRetirada.ToString("dd/MM/yyyy")
                    </strong>.


                    <div class="mt-2">

                        Horário previsto:

                        <strong>
                            @Model.DataRetirada.ToString("HH:mm")
                        </strong>.

                    </div>

                </div>
            }
            else if (periodoDaReservaTerminou)
            {
                <div class="alert alert-warning mb-0">

                    <strong>
                        Período encerrado.
                    </strong>

                    A data prevista de devolução desta reserva já passou.

                </div>
            }
            else if (podeIniciarLocacao)
            {
                <div class="alert alert-success">

                    <strong>
                        Veículo liberado para retirada.
                    </strong>

                    Entrada de
                    @valorEntrada.ToString("C")
                    confirmada.

                </div>


                <div class="reservation-money-grid mb-4">

                    <div class="reservation-money-box">

                        <span class="reservation-money-label">
                            Valor total
                        </span>

                        <p class="reservation-money-value">
                            @Model.ValorPrevisto.ToString("C")
                        </p>

                    </div>


                    <div class="reservation-money-box">

                        <span class="reservation-money-label">
                            Entrada já paga
                        </span>

                        <p class="reservation-money-value text-success">
                            @valorEntrada.ToString("C")
                        </p>

                        <span class="reservation-money-note reservation-money-note-success">
                            ✓ Confirmada
                        </span>

                    </div>


                    <div class="reservation-money-box">

                        <span class="reservation-money-label">
                            Saldo restante
                        </span>

                        <p class="reservation-money-value reservation-money-value-large">
                            @saldoRestante.ToString("C")
                        </p>

                    </div>

                </div>


                <form asp-controller="Reservas"
                      asp-action="IniciarLocacao"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />


                    <div class="reservation-form-grid">

                        <div class="reservation-form-col-6">

                            <label class="form-label">
                                Km de saída
                            </label>

                            <input type="number"
                                   name="kmSaida"
                                   class="form-control"
                                   min="0"
                                   required />

                        </div>


                        <div class="reservation-form-col-6">

                            <label class="form-label">
                                Combustível na saída (%)
                            </label>

                            <input type="number"
                                   name="combustivelSaidaPercentual"
                                   class="form-control"
                                   min="0"
                                   max="100"
                                   step="0.01"
                                   value="100"
                                   required />

                        </div>


                        <div class="reservation-form-col-12">

                            <label class="form-label">
                                Observações
                            </label>

                            <textarea name="observacoes"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Observações da retirada, se necessário.">@Model.Observacoes</textarea>

                        </div>

                    </div>


                    <div class="mt-4">

                        <button type="submit"
                                class="reservation-success-btn"
                                onclick="return confirm('Deseja iniciar esta locação?');">

                            Iniciar Locação

                        </button>

                    </div>

                </form>
            }

        </div>
    }


    <!-- ========================================= -->
    <!-- SITUAÇÕES FINAIS -->
    <!-- ========================================= -->
    @if (Model.Status == 5)
    {
        <div class="alert alert-primary reservation-final-alert">

            Esta reserva já foi concluída.

        </div>
    }
    else if (Model.Status == 3)
    {
        <div class="alert alert-danger reservation-final-alert">

            Esta reserva foi cancelada.

        </div>
    }
    else if (Model.Status == 4)
    {
        <div class="alert alert-secondary reservation-final-alert">

            Esta reserva expirou.

        </div>
    }
    else if (!modoAdministrador &&
             Model.Status == 2 &&
             Model.IsAtiva &&
             entradaPaga)
    {
        <div class="alert alert-success reservation-final-alert">

            <strong>
                Tudo certo com sua reserva.
            </strong>

            A entrada de
            @valorEntrada.ToString("C")
            foi paga e sua reserva está confirmada.

            O saldo restante é de

            <strong>
                @saldoRestante.ToString("C")
            </strong>.

        </div>
    }

</div>