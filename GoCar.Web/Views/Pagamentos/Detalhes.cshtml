@model GoCar.Web.Models.PagamentoViewModel

@{
    ViewData["Title"] = "Detalhes do Pagamento";

    string StatusPagamento(int status)
    {
        return status switch
        {
            1 => "Pendente",
            2 => "Pago",
            3 => "Cancelado",
            4 => "Estornado",
            _ => "Desconhecido"
        };
    }

    string FormaPagamento(int forma)
    {
        return forma switch
        {
            1 => "Pix",
            2 => "Cartão de Crédito",
            3 => "Cartão de Débito",
            4 => "Dinheiro",
            _ => "Desconhecida"
        };
    }

    bool ehEntrada =
        string.Equals(
            Model.Tipo,
            "Entrada",
            StringComparison.OrdinalIgnoreCase);

    string TipoPagamento()
    {
        if (ehEntrada)
        {
            return "Entrada da Reserva";
        }

        if (string.Equals(
            Model.Tipo,
            "Locação",
            StringComparison.OrdinalIgnoreCase))
        {
            return "Saldo da Locação";
        }

        return Model.Tipo ?? "Não informado";
    }
}

<style>

    .payment-details-page {
        color: #fff;
    }

        .payment-details-page .container {
            max-width: 1500px;
        }

    .payment-details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .payment-details-eyebrow {
        margin-bottom: 5px;
        color: #a98cc9;
        font-size: .86rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .65px;
    }

    .payment-details-title {
        margin: 0;
        color: #fff;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .payment-details-description {
        margin: 6px 0 0;
        color: #aaa0b5;
        font-size: .96rem;
        line-height: 1.5;
    }

    .payment-details-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .payment-details-page .btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding-left: 15px;
        padding-right: 15px;
        border-radius: 8px;
        font-size: .90rem;
        font-weight: 700;
    }

    .payment-details-page .btn-outline-dark {
        border-color: rgba(151,71,255,.24);
        background: rgba(126,44,255,.06);
        color: #c7b6dc;
    }

        .payment-details-page .btn-outline-dark:hover {
            border-color: rgba(151,71,255,.45);
            background: rgba(126,44,255,.12);
            color: #fff;
        }

    .payment-details-page .btn-dark {
        border-color: rgba(151,71,255,.35);
        background: rgba(126,44,255,.15);
        color: #fff;
    }

        .payment-details-page .btn-dark:hover {
            background: rgba(126,44,255,.25);
        }

    .payment-details-page .btn-success {
        border-color: rgba(34,197,94,.55);
        background: linear-gradient( 135deg, #159447, #22b95f );
        color: #fff;
    }

    .payment-details-page .btn-danger {
        border-color: rgba(244,63,94,.55);
        background: rgba(220,38,68,.88);
        color: #fff;
    }

    .payment-details-page .btn-warning {
        border-color: rgba(245,158,11,.55);
        background: rgba(245,158,11,.90);
        color: #1b1203;
    }

    .payment-details-page .alert {
        border-radius: 9px;
        font-size: .90rem;
        line-height: 1.55;
    }

    .payment-details-card {
        border: 1px solid rgba(151,71,255,.16) !important;
        border-radius: 11px !important;
        background: radial-gradient( circle at 92% 8%, rgba(126,44,255,.07), transparent 30% ), linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) ) !important;
        color: #fff;
        box-shadow: none !important;
    }

        .payment-details-card .card-body {
            padding: 24px !important;
        }

        .payment-details-card strong {
            display: block;
            margin-bottom: 5px;
            color: #aaa0b5;
            font-size: .84rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .35px;
        }

        .payment-details-card .text-muted {
            color: #e0d9e7 !important;
            font-size: .92rem;
            line-height: 1.5;
        }

        .payment-details-card .fw-semibold {
            font-weight: 800 !important;
        }

        .payment-details-card .badge {
            padding: 6px 10px;
            border-radius: 999px;
            font-size: .82rem;
            font-weight: 700;
        }

        .payment-details-card .text-success {
            color: #4ade80 !important;
            font-size: .90rem;
        }

        .payment-details-card .text-danger {
            color: #fb7185 !important;
            font-size: .90rem;
        }

        .payment-details-card hr {
            margin: 22px 0;
            border-color: rgba(255,255,255,.08);
            opacity: 1;
        }

    @@media (max-width: 768px) {

        .payment-details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .payment-details-actions {
            width: 100%;
        }

            .payment-details-actions .btn {
                flex: 1;
            }

        .payment-details-card .card-body {
            padding: 18px !important;
        }

        .payment-details-title {
            font-size: 1.55rem;
        }
    }

</style>


<section class="gocar-section payment-details-page">

    <div class="container">

        <div class="payment-details-header">

            <div>

                <div class="payment-details-eyebrow">
                    Financeiro
                </div>

                <h1 class="payment-details-title">
                    Pagamento #@Model.Id
                </h1>

                <p class="payment-details-description">

                    @if (Model.ReservaId.HasValue)
                    {
                        <span>
                            Detalhes do pagamento da reserva.
                        </span>
                    }
                    else if (Model.LocacaoId.HasValue)
                    {
                        <span>
                            Detalhes do pagamento da locação.
                        </span>
                    }
                    else
                    {
                        <span>
                            Detalhes do pagamento.
                        </span>
                    }

                </p>

            </div>


            <div class="payment-details-actions">

                <a asp-controller="Pagamentos"
                   asp-action="Index"
                   class="btn btn-outline-dark">

                    Voltar

                </a>


                @if (Model.LocacaoId.HasValue)
                {
                    <a asp-controller="Locacoes"
                       asp-action="Detalhes"
                       asp-route-id="@Model.LocacaoId"
                       class="btn btn-dark">

                        Ver Locação

                    </a>
                }


                @if (Model.ReservaId.HasValue)
                {
                    <a asp-controller="Reservas"
                       asp-action="Detalhes"
                       asp-route-id="@Model.ReservaId"
                       class="btn btn-dark">

                        Ver Reserva

                    </a>
                }

            </div>

        </div>


        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success">
                @TempData["Sucesso"]
            </div>
        }


        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Erro"]
            </div>
        }


        <div class="card payment-details-card">

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">

                        <strong>
                            ID do pagamento
                        </strong>

                        <div class="text-muted">
                            #@Model.Id
                        </div>

                    </div>


                    <div class="col-md-6">

                        @if (Model.ReservaId.HasValue)
                        {
                            <strong>
                                Reserva
                            </strong>

                            <div class="text-muted">
                                #@Model.ReservaId
                            </div>
                        }
                        else if (Model.LocacaoId.HasValue)
                        {
                            <strong>
                                Locação
                            </strong>

                            <div class="text-muted">
                                #@Model.LocacaoId
                            </div>
                        }
                        else
                        {
                            <strong>
                                Vínculo
                            </strong>

                            <div class="text-muted">
                                Não informado
                            </div>
                        }

                    </div>


                    <div class="col-md-6">

                        <strong>
                            Tipo
                        </strong>

                        <div class="text-muted">
                            @TipoPagamento()
                        </div>

                    </div>


                    <div class="col-md-6">

                        <strong>
                            Forma de pagamento
                        </strong>

                        <div class="text-muted">
                            @FormaPagamento(Model.FormaPagamento)
                        </div>

                    </div>


                    <div class="col-md-6">

                        <strong>
                            Status
                        </strong>

                        <div class="mt-1">

                            @if (Model.Status == 1)
                            {
                                <span class="badge bg-warning text-dark">
                                    Pendente
                                </span>
                            }
                            else if (Model.Status == 2)
                            {
                                <span class="badge bg-success">
                                    Pago
                                </span>
                            }
                            else if (Model.Status == 3)
                            {
                                <span class="badge bg-danger">
                                    Cancelado
                                </span>
                            }
                            else if (Model.Status == 4)
                            {
                                <span class="badge bg-secondary">
                                    Estornado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @StatusPagamento(Model.Status)
                                </span>
                            }

                        </div>

                    </div>


                    <div class="col-md-6">

                        <strong>
                            Valor
                        </strong>

                        <div class="text-muted fw-semibold">
                            @Model.Valor.ToString("C")
                        </div>

                    </div>


                    <div class="col-md-6">

                        <strong>
                            Data do pagamento
                        </strong>

                        <div class="text-muted">

                            @if (Model.DataPagamento.HasValue)
                            {
                                @Model.DataPagamento.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span>
                                    Ainda não pago
                                </span>
                            }

                        </div>

                    </div>


                    <div class="col-md-6">

                        <strong>
                            Data de criação
                        </strong>

                        <div class="text-muted">
                            @Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                        </div>

                    </div>


                    <div class="col-md-6">

                        <strong>
                            Situação
                        </strong>

                        <div>

                            @if (Model.IsAtivo)
                            {
                                <span class="text-success fw-semibold">
                                    Ativo
                                </span>
                            }
                            else
                            {
                                <span class="text-danger fw-semibold">
                                    Inativo
                                </span>
                            }

                        </div>

                    </div>


                    <div class="col-12">

                        <strong>
                            Observações
                        </strong>

                        <div class="text-muted mt-1">

                            @if (!string.IsNullOrWhiteSpace(Model.Observacoes))
                            {
                                @Model.Observacoes
                            }
                            else
                            {
                                <span>
                                    Nenhuma observação.
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <div class="d-flex gap-2 flex-wrap align-items-center">

                    @if (Model.Status == 1)
                    {
                        <form asp-controller="Pagamentos"
                              asp-action="MarcarComoPago"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-success">

                                Marcar como Pago

                            </button>

                        </form>


                        <form asp-controller="Pagamentos"
                              asp-action="Cancelar"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Deseja realmente cancelar este pagamento?');">

                                Cancelar Pagamento

                            </button>

                        </form>
                    }


                    @if (Model.Status == 2)
                    {
                        <form asp-controller="Pagamentos"
                              asp-action="Estornar"
                              method="post"
                              onsubmit="return confirm('@(ehEntrada
                                                              ? "Deseja realmente estornar a entrada desta reserva?"
                                                              : "Deseja realmente estornar este pagamento?")');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-warning">

                                @(ehEntrada
                                    ? "Estornar Entrada"
                                    : "Estornar Pagamento")

                            </button>

                        </form>


                        @if (ehEntrada)
                        {
                            <div class="alert alert-warning mb-0">

                                <strong>
                                    Entrada paga.
                                </strong>

                                O estorno mantém o pagamento no histórico,
                                mas altera seu status para estornado.

                            </div>
                        }
                    }


                    @if (Model.Status == 3)
                    {
                        <div class="alert alert-danger mb-0">
                            Este pagamento foi cancelado.
                        </div>
                    }


                    @if (Model.Status == 4)
                    {
                        <div class="alert alert-secondary mb-0">

                            <strong>
                                Pagamento estornado.
                            </strong>

                            Este registro permanece no histórico financeiro.

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</section>