@model List<GoCar.Web.Models.VeiculoViewModel>

@using GoCar.Web.Helpers

@{
    ViewData["Title"] = "Veículos";

    string ObterStatus(int status)
    {
        return status switch
        {
            1 => "Disponível",
            2 => "Reservado",
            3 => "Alugado",
            4 => "Manutenção",
            5 => "Inativo",
            _ => "Desconhecido"
        };
    }

    string ClasseStatus(int status, bool ativo)
    {
        if (!ativo)
            return "fleet-status-inativo";

        return status switch
        {
            1 => "fleet-status-disponivel",
            2 => "fleet-status-reservado",
            3 => "fleet-status-alugado",
            4 => "fleet-status-manutencao",
            _ => "fleet-status-inativo"
        };
    }

    var total = Model.Count;
    var disponiveis = Model.Count(v => v.IsAtivo && v.Status == 1);
    var reservados = Model.Count(v => v.IsAtivo && v.Status == 2);
    var alugados = Model.Count(v => v.IsAtivo && v.Status == 3);
    var manutencao = Model.Count(v => v.IsAtivo && v.Status == 4);
}

<style>
    .fleet-page {
        max-width: 1600px;
        margin: auto;
        padding: 32px;
        color: #fff;
    }

    .fleet-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .fleet-eyebrow {
        color: #b0a5bb;
        font-size: .90rem;
        margin-bottom: 4px;
    }

    .fleet-title {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .fleet-description {
        color: #aaa0b5;
        font-size: .96rem;
        margin: 6px 0 0;
    }

    .fleet-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 17px;
        border-radius: 9px;
        border: 1px solid #8b3dff;
        background: linear-gradient(135deg, #7c2cff, #9b4dff);
        color: #fff;
        text-decoration: none;
        font-size: .92rem;
        font-weight: 700;
        box-shadow: 0 8px 25px rgba(126,44,255,.2);
    }

        .fleet-new:hover {
            color: white;
            transform: translateY(-1px);
        }

    .fleet-summary {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 13px;
        margin-bottom: 18px;
    }

    .fleet-summary-card {
        padding: 15px 17px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 10px;
        background: linear-gradient( 145deg, rgba(24,13,41,.96), rgba(14,8,25,.96) );
    }

    .fleet-summary-label {
        color: #aaa0b5;
        font-size: .86rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .fleet-summary-value {
        margin-top: 3px;
        color: #fff;
        font-size: 1.35rem;
        font-weight: 800;
    }

    .fleet-panel {
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient( 145deg, rgba(21,11,37,.97), rgba(13,7,24,.97) );
        overflow: hidden;
    }

    .fleet-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 16px 18px;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }

    .fleet-search {
        width: min(430px, 100%);
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 13px;
        border: 1px solid rgba(151,71,255,.18);
        border-radius: 8px;
        background: rgba(255,255,255,.025);
    }

        .fleet-search input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            color: white;
            font-size: .92rem;
        }

            .fleet-search input::placeholder {
                color: #665d72;
            }

    .fleet-filter {
        padding: 9px 12px;
        border: 1px solid rgba(151,71,255,.18);
        border-radius: 8px;
        outline: 0;
        background: #130b20;
        color: #aaa1b7;
        font-size: .90rem;
    }

    .fleet-table-wrapper {
        overflow-x: auto;
    }

    .fleet-table {
        width: 100%;
        border-collapse: collapse;
    }

        .fleet-table th {
            padding: 12px 16px;
            background: rgba(255,255,255,.015);
            border-bottom: 1px solid rgba(255,255,255,.05);
            color: #aaa0b5;
            font-size: .82rem;
            font-weight: 700;
            text-align: left;
            white-space: nowrap;
        }

        .fleet-table td {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(255,255,255,.045);
            color: #bcb4c7;
            font-size: .92rem;
            vertical-align: middle;
        }

        .fleet-table tbody tr {
            transition: .15s ease;
        }

            .fleet-table tbody tr:hover {
                background: rgba(126,44,255,.055);
            }

            .fleet-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .fleet-vehicle {
        min-width: 220px;
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .fleet-image-box {
        width: 78px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: radial-gradient( circle, rgba(151,71,255,.12), rgba(255,255,255,.015) 70% );
    }

    .fleet-image {
        width: 72px;
        height: 44px;
        object-fit: contain;
    }

    .fleet-vehicle-name {
        color: #f0edf4;
        font-size: .92rem;
        font-weight: 700;
    }

    .fleet-vehicle-meta {
        color: #9f95aa;
        font-size: .82rem;
        margin-top: 3px;
    }

    .fleet-plate {
        color: #eeeaf3;
        font-weight: 700;
        letter-spacing: .4px;
    }

    .fleet-price {
        color: #eeeaf3;
        font-weight: 700;
        white-space: nowrap;
    }

        .fleet-price span {
            color: #9f95aa;
            font-weight: 400;
            font-size: .80rem;
        }

    .fleet-status {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .fleet-status-disponivel {
        color: #3ce78c;
        background: rgba(26,192,103,.12);
    }

    .fleet-status-reservado {
        color: #c084fc;
        background: rgba(168,85,247,.14);
    }

    .fleet-status-alugado {
        color: #ff7196;
        background: rgba(244,63,94,.13);
    }

    .fleet-status-manutencao {
        color: #fbbf24;
        background: rgba(245,158,11,.13);
    }

    .fleet-status-inativo {
        color: #94a3b8;
        background: rgba(148,163,184,.12);
    }

    .fleet-actions {
        min-width: 205px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .fleet-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 31px;
        padding: 0 9px;
        border: 1px solid rgba(151,71,255,.18);
        border-radius: 7px;
        background: rgba(255,255,255,.025);
        color: #fff !important;
        text-decoration: none;
        font-size: .82rem;
        font-weight: 600;
    }

        .fleet-action:hover {
            color: white;
            border-color: rgba(151,71,255,.45);
            background: rgba(126,44,255,.10);
        }

    .fleet-action-edit {
        color: #c084fc;
    }

    .fleet-action-danger {
        color: #ff718d;
        border-color: rgba(244,63,94,.18);
    }

    .fleet-action-success {
        color: #3ce78c;
        border-color: rgba(34,197,94,.18);
    }

    button.fleet-action {
        cursor: pointer;
    }

    .fleet-empty {
        padding: 60px 20px !important;
        color: #756c80 !important;
        text-align: center;
    }

    .fleet-alert {
        margin-bottom: 16px;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 9px;
    }

    @@media (max-width: 1100px) {
        .fleet-summary {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 700px) {
        .fleet-page {
            padding: 20px 15px;
        }

        .fleet-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .fleet-summary {
            grid-template-columns: repeat(2, 1fr);
        }

        .fleet-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .fleet-search {
            width: 100%;
        }
    }
</style>

<div class="fleet-page">

    <div class="fleet-header">

        <div>
            <div class="fleet-eyebrow">
                GERENCIAMENTO DA FROTA
            </div>

            <h1 class="fleet-title">
                Veículos
            </h1>

            <p class="fleet-description">
                Visualize e gerencie todos os veículos da GoCar.
            </p>
        </div>

        <a asp-controller="Veiculos"
           asp-action="Criar"
           class="fleet-new">
            + Novo veículo
        </a>

    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success fleet-alert">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger fleet-alert">
            @TempData["Erro"]
        </div>
    }

    @if (ViewBag.MensagemErro != null)
    {
        <div class="alert alert-danger fleet-alert">
            @ViewBag.MensagemErro
        </div>
    }

    <!-- RESUMO -->

    <div class="fleet-summary">

        <div class="fleet-summary-card">
            <div class="fleet-summary-label">
                Total
            </div>
            <div class="fleet-summary-value">
                @total
            </div>
        </div>

        <div class="fleet-summary-card">
            <div class="fleet-summary-label">
                Disponíveis
            </div>
            <div class="fleet-summary-value">
                @disponiveis
            </div>
        </div>

        <div class="fleet-summary-card">
            <div class="fleet-summary-label">
                Reservados
            </div>
            <div class="fleet-summary-value">
                @reservados
            </div>
        </div>

        <div class="fleet-summary-card">
            <div class="fleet-summary-label">
                Alugados
            </div>
            <div class="fleet-summary-value">
                @alugados
            </div>
        </div>

        <div class="fleet-summary-card">
            <div class="fleet-summary-label">
                Manutenção
            </div>
            <div class="fleet-summary-value">
                @manutencao
            </div>
        </div>

    </div>

    <!-- LISTAGEM -->

    <section class="fleet-panel">

        <div class="fleet-toolbar">

            <div class="fleet-search">
                <span>⌕</span>

                <input type="text"
                       id="fleetSearch"
                       placeholder="Buscar por veículo, marca ou placa..." />
            </div>

            <select id="fleetStatusFilter"
                    class="fleet-filter">

                <option value="">
                    Todos os status
                </option>

                <option value="Disponível">
                    Disponível
                </option>

                <option value="Reservado">
                    Reservado
                </option>

                <option value="Alugado">
                    Alugado
                </option>

                <option value="Manutenção">
                    Manutenção
                </option>

                <option value="Inativo">
                    Inativo
                </option>

            </select>

        </div>

        <div class="fleet-table-wrapper">

            <table class="fleet-table">

                <thead>
                    <tr>
                        <th>VEÍCULO</th>
                        <th>PLACA</th>
                        <th>ANO</th>
                        <th>QUILOMETRAGEM</th>
                        <th>DIÁRIA</th>
                        <th>STATUS</th>
                        <th>AÇÕES</th>
                    </tr>
                </thead>

                <tbody id="fleetTableBody">

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7"
                                class="fleet-empty">

                                Nenhum veículo encontrado.

                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var veiculo in Model)
                        {
                            var imagem =
                                VeiculoImagemHelper.ObterImagem(
                                    veiculo.Marca,
                                    veiculo.Modelo);

                            var status =
                                veiculo.IsAtivo
                                    ? ObterStatus(veiculo.Status)
                                    : "Inativo";

                            <tr class="fleet-row"
                                data-search="@($"{veiculo.Marca} {veiculo.Modelo} {veiculo.Placa}".ToLower())"
                                data-status="@status">

                                <td>

                                    <div class="fleet-vehicle">

                                        <div class="fleet-image-box">

                                            <img src="@imagem"
                                                 alt="@($"{veiculo.Marca} {veiculo.Modelo}")"
                                                 class="fleet-image" />

                                        </div>

                                        <div>

                                            <div class="fleet-vehicle-name">
                                                @veiculo.Marca
                                                @veiculo.Modelo
                                            </div>

                                            <div class="fleet-vehicle-meta">
                                                ID #@veiculo.Id
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <span class="fleet-plate">
                                        @veiculo.Placa
                                    </span>
                                </td>

                                <td>
                                    @veiculo.AnoModelo
                                </td>

                                <td>
                                    @veiculo.KmAtual.ToString("N0") km
                                </td>

                                <td>
                                    <div class="fleet-price">

                                        @veiculo.ValorDiaria.ToString("C")

                                        <span>
                                            / dia
                                        </span>

                                    </div>
                                </td>

                                <td>

                                    <span class="
                                        fleet-status
                                        @ClasseStatus(
                                            veiculo.Status,
                                            veiculo.IsAtivo)">

                                        @status

                                    </span>

                                </td>

                                <td>

                                    <div class="fleet-actions">

                                        <a asp-controller="Veiculos"
                                           asp-action="Detalhes"
                                           asp-route-id="@veiculo.Id"
                                           class="fleet-action">

                                            Visualizar

                                        </a>

                                        <a asp-controller="Veiculos"
                                           asp-action="Editar"
                                           asp-route-id="@veiculo.Id"
                                           class="fleet-action fleet-action-edit">

                                            Editar

                                        </a>

                                        @if (veiculo.IsAtivo)
                                        {
                                            <form asp-controller="Veiculos"
                                                  asp-action="Desativar"
                                                  asp-route-id="@veiculo.Id"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Deseja realmente desativar este veículo?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="fleet-action fleet-action-danger">

                                                    Desativar

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Veiculos"
                                                  asp-action="Ativar"
                                                  asp-route-id="@veiculo.Id"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Deseja reativar este veículo?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="fleet-action fleet-action-success">

                                                    Ativar

                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </section>

</div>

@section Scripts {

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const search =
                    document.getElementById(
                        "fleetSearch"
                    );

                const statusFilter =
                    document.getElementById(
                        "fleetStatusFilter"
                    );

                const rows =
                    document.querySelectorAll(
                        ".fleet-row"
                    );

                function filtrarVeiculos() {

                    const texto =
                        (search?.value || "")
                            .trim()
                            .toLowerCase();

                    const status =
                        statusFilter?.value || "";

                    rows.forEach(function(row) {

                        const dados =
                            row.dataset.search || "";

                        const statusLinha =
                            row.dataset.status || "";

                        const correspondeTexto =
                            !texto ||
                            dados.includes(texto);

                        const correspondeStatus =
                            !status ||
                            statusLinha === status;

                        row.style.display =
                            correspondeTexto &&
                                correspondeStatus
                                ? ""
                                : "none";
                    });
                }

                search?.addEventListener(
                    "input",
                    filtrarVeiculos
                );

                statusFilter?.addEventListener(
                    "change",
                    filtrarVeiculos
                );

            }
        );
    </script>

}