@model List<GoCar.Web.Models.LocacaoViewModel>

@{
    var modoAdministrador =
        ViewBag.ModoAdministrador != null
        && (bool)ViewBag.ModoAdministrador;

    ViewData["Title"] =
        modoAdministrador
            ? "Locações"
            : "Minhas Locações";

    var totalLocacoes = Model.Count;

    var locacoesAtivas =
        Model.Count(l =>
            l.Status == 1 &&
            l.IsAtiva);

    var locacoesFinalizadas =
        Model.Count(l =>
            l.Status == 2);

    var locacoesCanceladas =
        Model.Count(l =>
            l.Status == 3);

    var valorTotalLocacoes =
        Model
            .Where(l =>
                l.Status != 3)
            .Sum(l =>
                l.ValorTotal);

    string NomeStatus(int status)
    {
        return status switch
        {
            1 => "Ativa",
            2 => "Finalizada",
            3 => "Cancelada",
            _ => $"Status {status}"
        };
    }

    string ClasseStatus(int status)
    {
        return status switch
        {
            1 => "rental-status-active",
            2 => "rental-status-finished",
            3 => "rental-status-cancelled",
            _ => "rental-status-default"
        };
    }
}

<style>

    .rentals-page {
        max-width: 1600px;
        margin: auto;
        padding: 32px;
        color: #fff;
    }

    .rentals-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .rentals-eyebrow {
        margin-bottom: 4px;
        color: #8d849a;
        font-size: .90rem;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .rentals-title {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .rentals-description {
        margin: 6px 0 0;
        color: #81778e;
        font-size: .96rem;
    }

    .rentals-back {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 15px;
        border: 1px solid rgba(151,71,255,.24);
        border-radius: 8px;
        background: rgba(126,44,255,.06);
        color: #bca9d4;
        text-decoration: none;
        font-size: .90rem;
        font-weight: 700;
        transition: .18s ease;
    }

        .rentals-back:hover {
            color: #fff;
            background: rgba(126,44,255,.12);
            border-color: rgba(151,71,255,.45);
        }

    .rentals-summary {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 13px;
        margin-bottom: 18px;
    }

    .rental-summary-card {
        position: relative;
        overflow: hidden;
        padding: 16px 17px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 10px;
        background: linear-gradient( 145deg, rgba(24,13,41,.96), rgba(14,8,25,.96) );
    }

        .rental-summary-card::after {
            content: "";
            position: absolute;
            width: 75px;
            height: 75px;
            right: -35px;
            top: -35px;
            border-radius: 50%;
            background: rgba(139,51,255,.07);
        }

    .rental-summary-label {
        color: #81778d;
        font-size: .86rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .rental-summary-value {
        margin-top: 5px;
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
    }

    .rental-summary-money {
        color: #c084fc;
    }

    .rentals-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 16px;
        padding: 14px 16px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 10px;
        background: linear-gradient( 145deg, rgba(21,11,37,.97), rgba(13,7,24,.97) );
    }

    .rentals-search {
        width: min(430px, 100%);
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 13px;
        border: 1px solid rgba(151,71,255,.18);
        border-radius: 8px;
        background: rgba(255,255,255,.025);
    }

        .rentals-search span {
            color: #786d85;
        }

        .rentals-search input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            color: #fff;
            font-size: .92rem;
        }

            .rentals-search input::placeholder {
                color: #665d72;
            }

    .rentals-toolbar-right {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .rentals-count {
        color: #71677d;
        font-size: .86rem;
        white-space: nowrap;
    }

        .rentals-count strong {
            color: #c2b7cf;
        }

    .rentals-filter {
        padding: 9px 12px;
        border: 1px solid rgba(151,71,255,.18);
        border-radius: 8px;
        outline: 0;
        background: #130b20;
        color: #aaa1b7;
        font-size: .90rem;
    }

    .rentals-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
    }

    .rental-card {
        overflow: hidden;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient( 145deg, rgba(21,11,37,.98), rgba(13,7,24,.98) );
        transition: .18s ease;
    }

        .rental-card:hover {
            border-color: rgba(151,71,255,.30);
            transform: translateY(-1px);
        }

    .rental-card-header {
        min-height: 65px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 14px 17px;
        border-bottom: 1px solid rgba(255,255,255,.045);
    }

    .rental-number small {
        display: block;
        margin-bottom: 2px;
        color: #756b80;
        font-size: .84rem;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .rental-number strong {
        color: #fff;
        font-size: 1rem;
    }

    .rental-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 700;
    }

        .rental-status::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: currentColor;
        }

    .rental-status-active {
        color: #3ce78c;
        background: rgba(26,192,103,.12);
    }

    .rental-status-finished {
        color: #7ab8ff;
        background: rgba(59,130,246,.13);
    }

    .rental-status-cancelled {
        color: #ff718d;
        background: rgba(244,63,94,.13);
    }

    .rental-status-default {
        color: #94a3b8;
        background: rgba(148,163,184,.11);
    }

    .rental-body {
        padding: 17px;
    }

    .rental-main-info {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .rental-info-label {
        margin-bottom: 3px;
        color: #706677;
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .rental-info-value {
        color: #d7d1df;
        font-size: .90rem;
        font-weight: 600;
        line-height: 1.4;
    }

    .rental-info-muted {
        color: #6f6579;
        font-size: .86rem;
    }

    .rental-reservation {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 17px;
        padding: 12px 13px;
        border: 1px solid rgba(151,71,255,.10);
        border-radius: 8px;
        background: rgba(255,255,255,.015);
    }

    .rental-reservation-label {
        color: #706677;
        font-size: .82rem;
        text-transform: uppercase;
    }

    .rental-reservation-number {
        margin-top: 2px;
        color: #e0d8e9;
        font-size: .92rem;
        font-weight: 700;
    }

    .rental-reservation-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: #a855f7;
        background: rgba(139,51,255,.10);
    }

    .rental-km-box {
        display: grid;
        grid-template-columns: 1fr 36px 1fr;
        align-items: center;
        gap: 8px;
        margin-top: 17px;
        padding: 12px;
        border: 1px solid rgba(151,71,255,.10);
        border-radius: 8px;
        background: rgba(255,255,255,.015);
    }

    .rental-km-arrow {
        color: #8640d9;
        text-align: center;
    }

    .rental-finance {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-top: 17px;
        padding: 13px;
        border: 1px solid rgba(151,71,255,.11);
        border-radius: 8px;
        background: rgba(126,44,255,.035);
    }

    .rental-finance-label {
        color: #706677;
        font-size: .82rem;
        text-transform: uppercase;
    }

    .rental-finance-value {
        margin-top: 3px;
        color: #fff;
        font-size: .96rem;
        font-weight: 800;
    }

    .rental-situation {
        text-align: right;
    }

    .rental-active-text {
        color: #3ce78c;
        font-size: .86rem;
        font-weight: 700;
    }

    .rental-inactive-text {
        color: #7f748a;
        font-size: .86rem;
        font-weight: 700;
    }

    .rental-footer {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 13px 17px;
        border-top: 1px solid rgba(255,255,255,.045);
        background: rgba(0,0,0,.07);
    }

    .rental-action {
        min-height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 11px;
        border: 1px solid rgba(151,71,255,.18);
        border-radius: 7px;
        background: rgba(255,255,255,.025);
        color: #bbb1c6;
        text-decoration: none;
        font-size: .86rem;
        font-weight: 700;
        transition: .15s ease;
    }

        .rental-action:hover {
            color: #fff;
            background: rgba(126,44,255,.10);
            border-color: rgba(151,71,255,.40);
        }

    .rental-action-active {
        color: #d5b3ff;
        border-color: rgba(151,71,255,.30);
        background: rgba(126,44,255,.08);
    }

    .rentals-empty {
        padding: 60px 25px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient( 145deg, rgba(21,11,37,.97), rgba(13,7,24,.97) );
        text-align: center;
    }

    .rentals-empty-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 13px;
        border-radius: 50%;
        color: #a855f7;
        background: rgba(139,51,255,.12);
        font-size: 1.2rem;
    }

    .rentals-empty h3 {
        margin-bottom: 7px;
        color: #fff;
        font-size: 1rem;
    }

    .rentals-empty p {
        color: #746b7e;
        font-size: .88rem;
    }

    .rental-hidden {
        display: none !important;
    }

    @@media (max-width: 1150px) {

        .rentals-summary {
            grid-template-columns: repeat(3, 1fr);
        }

        .rentals-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {

        .rentals-page {
            padding: 20px 15px;
        }

        .rentals-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .rentals-summary {
            grid-template-columns: repeat(2, 1fr);
        }

        .rentals-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .rentals-search {
            width: 100%;
        }

        .rentals-toolbar-right {
            justify-content: space-between;
        }

        .rental-main-info {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="rentals-page">

    <div class="rentals-header">

        <div>

            <div class="rentals-eyebrow">

                @(modoAdministrador
                    ? "Gerenciamento de locações"
                    : "Área do cliente")

            </div>

            <h1 class="rentals-title">

                @(modoAdministrador
                    ? "Locações"
                    : "Minhas Locações")

            </h1>

            <p class="rentals-description">

                @(modoAdministrador
                    ? "Acompanhe as retiradas, devoluções e locações da GoCar."
                    : "Acompanhe suas locações e devoluções.")

            </p>

        </div>


        @if (modoAdministrador)
        {
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="rentals-back">

                ← Dashboard

            </a>
        }

    </div>


    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Erro"]
        </div>
    }

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (ViewBag.MensagemErro != null)
    {
        <div class="alert alert-danger">
            @ViewBag.MensagemErro
        </div>
    }


    @if (Model.Count > 0)
    {
        <div class="rentals-summary">

            <div class="rental-summary-card">

                <div class="rental-summary-label">
                    Total
                </div>

                <div class="rental-summary-value">
                    @totalLocacoes
                </div>

            </div>


            <div class="rental-summary-card">

                <div class="rental-summary-label">
                    Ativas
                </div>

                <div class="rental-summary-value">
                    @locacoesAtivas
                </div>

            </div>


            <div class="rental-summary-card">

                <div class="rental-summary-label">
                    Finalizadas
                </div>

                <div class="rental-summary-value">
                    @locacoesFinalizadas
                </div>

            </div>


            <div class="rental-summary-card">

                <div class="rental-summary-label">
                    Canceladas
                </div>

                <div class="rental-summary-value">
                    @locacoesCanceladas
                </div>

            </div>


            <div class="rental-summary-card">

                <div class="rental-summary-label">
                    Valor das locações
                </div>

                <div class="
                    rental-summary-value
                    rental-summary-money">

                    @valorTotalLocacoes.ToString("C")

                </div>

            </div>

        </div>


        <div class="rentals-toolbar">

            <div class="rentals-search">

                <span>⌕</span>

                <input type="text"
                       id="rentalSearch"
                       placeholder="Buscar por locação ou reserva..." />

            </div>


            <div class="rentals-toolbar-right">

                <span class="rentals-count">

                    <strong id="rentalCount">
                        @Model.Count
                    </strong>

                    locações

                </span>


                <select id="rentalStatusFilter"
                        class="rentals-filter">

                    <option value="">
                        Todos os status
                    </option>

                    <option value="Ativa">
                        Ativas
                    </option>

                    <option value="Finalizada">
                        Finalizadas
                    </option>

                    <option value="Cancelada">
                        Canceladas
                    </option>

                </select>

            </div>

        </div>


        <div class="rentals-grid">

            @foreach (var locacao in Model)
            {
                var statusNome =
                    NomeStatus(locacao.Status);

                var pesquisa =
                    $"{locacao.Id} {locacao.ReservaId}";


                <article class="rental-card rental-item"
                         data-status="@statusNome"
                         data-search="@pesquisa">


                    <div class="rental-card-header">

                        <div class="rental-number">

                            <small>
                                Locação
                            </small>

                            <strong>
                                #@locacao.Id
                            </strong>

                        </div>


                        <span class="
                            rental-status
                            @ClasseStatus(locacao.Status)">

                            @statusNome

                        </span>

                    </div>


                    <div class="rental-body">

                        <div class="rental-reservation">

                            <div>

                                <div class="
                                    rental-reservation-label">

                                    Reserva vinculada

                                </div>

                                <div class="
                                    rental-reservation-number">

                                    Reserva #@locacao.ReservaId

                                </div>

                            </div>


                            <div class="
                                rental-reservation-icon">

                                ▣

                            </div>

                        </div>


                        <div class="rental-main-info">

                            <div>

                                <div class="
                                    rental-info-label">

                                    Data de retirada

                                </div>

                                <div class="
                                    rental-info-value">

                                    @(locacao.DataRetirada.ToString("dd/MM/yyyy HH:mm"))

                                </div>

                            </div>


                            <div>

                                <div class="
                                    rental-info-label">

                                    Devolução

                                </div>

                                <div class="
                                    rental-info-value">

                                    @if (locacao.DataDevolucaoReal.HasValue)
                                    {
                                        @(locacao.DataDevolucaoReal.Value.ToString("dd/MM/yyyy HH:mm"))
                                    }
                                    else
                                    {
                                        <span class="
                                            rental-info-muted">

                                            Ainda não realizada

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        <div class="rental-km-box">

                            <div>

                                <div class="
                                    rental-info-label">

                                    Km saída

                                </div>

                                <div class="
                                    rental-info-value">

                                    @(locacao.KmSaida.ToString("N0")) km

                                </div>

                            </div>


                            <div class="rental-km-arrow">
                                →
                            </div>


                            <div>

                                <div class="
                                    rental-info-label">

                                    Km entrada

                                </div>

                                <div class="
                                    rental-info-value">

                                    @if (locacao.KmEntrada.HasValue)
                                    {
                                        @($"{locacao.KmEntrada.Value:N0} km")
                                    }
                                    else
                                    {
                                        <span class="
                                            rental-info-muted">

                                            Pendente

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        <div class="rental-finance">

                            <div>

                                <div class="
                                    rental-finance-label">

                                    Valor total

                                </div>

                                <div class="
                                    rental-finance-value">

                                    @(locacao.ValorTotal.ToString("C"))

                                </div>

                            </div>


                            <div class="rental-situation">

                                <div class="
                                    rental-finance-label">

                                    Situação

                                </div>

                                @if (locacao.IsAtiva)
                                {
                                    <div class="
                                        rental-active-text">

                                        ● Em andamento

                                    </div>
                                }
                                else
                                {
                                    <div class="
                                        rental-inactive-text">

                                        ● Encerrada

                                    </div>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="rental-footer">

                        <a asp-controller="Locacoes"
                           asp-action="Detalhes"
                           asp-route-id="@locacao.Id"
                           class="rental-action @(locacao.IsAtiva ? "rental-action-active" : "")">

                            @(locacao.IsAtiva
                                ? "Gerenciar locação"
                                : "Visualizar detalhes")

                        </a>

                    </div>

                </article>
            }

        </div>
    }
    else
    {
        <div class="rentals-empty">

            <div class="rentals-empty-icon">
                ◇
            </div>

            <h3>
                Nenhuma locação encontrada
            </h3>

            <p>
                Não existem locações para exibir
                no momento.
            </p>


            @if (modoAdministrador)
            {
                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="rentals-back">

                    ← Voltar ao Dashboard

                </a>
            }
            else
            {
                <a asp-controller="Home"
                   asp-action="Index"
                   class="rentals-back">

                    Voltar ao início

                </a>
            }

        </div>
    }

</div>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const search =
                    document.getElementById(
                        "rentalSearch"
                    );

                const statusFilter =
                    document.getElementById(
                        "rentalStatusFilter"
                    );

                const count =
                    document.getElementById(
                        "rentalCount"
                    );

                const items =
                    document.querySelectorAll(
                        ".rental-item"
                    );


                function filtrarLocacoes() {

                    const texto =
                        (search?.value || "")
                            .trim()
                            .toLowerCase();

                    const status =
                        statusFilter?.value || "";

                    let visiveis = 0;


                    items.forEach(
                        function(item) {

                            const dados =
                                (
                                    item.dataset.search
                                    || ""
                                )
                                    .toLowerCase();

                            const statusItem =
                                item.dataset.status
                                || "";


                            const correspondeTexto =
                                !texto ||
                                dados.includes(texto);


                            const correspondeStatus =
                                !status ||
                                statusItem === status;


                            const mostrar =
                                correspondeTexto &&
                                correspondeStatus;


                            item.classList.toggle(
                                "rental-hidden",
                                !mostrar
                            );


                            if (mostrar) {
                                visiveis++;
                            }

                        }
                    );


                    if (count) {
                        count.textContent =
                            visiveis;
                    }

                }


                search?.addEventListener(
                    "input",
                    filtrarLocacoes
                );


                statusFilter?.addEventListener(
                    "change",
                    filtrarLocacoes
                );

            }
        );

    </script>

}